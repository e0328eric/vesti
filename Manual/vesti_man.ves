docclass article (10pt)
importpkg {
    fontenc (T1),
    inputenc (utf8),
    geometry (a4paper, margin = 2.3cm),
    microtype (expansion=false),
    amsmath,
    amssymb,
    xcolor,
    tikz,
    fancyvrb,
    listings,
    tcolorbox,
    booktabs,
    longtable,
    array,
    enumitem,
    titlesec,
    fancyhdr,
    hyperref,
}

%-
\tcbuselibrary{skins,breakable}
