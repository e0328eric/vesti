\definecolor{vkw}{HTML}{8E44AD}      % keywords (purple)
\definecolor{vbi}{HTML}{1F6FB2}      % builtins (blue)
\definecolor{vstr}{HTML}{1E8449}     % strings / literals (green)
\definecolor{vcom}{HTML}{8A8A8A}     % comments (grey)
\definecolor{vlua}{HTML}{B9770E}     % lua (amber)
\definecolor{vbg}{HTML}{FAF8FC}      % code background
\definecolor{vrule}{HTML}{E3DAEC}    % code frame
\definecolor{vlink}{HTML}{6C3483}
\definecolor{vurl}{HTML}{1F6FB2}
\definecolor{vink}{HTML}{2C2230}     % main text ink
\definecolor{vhead}{HTML}{4A235A}    % heading ink
\definecolor{vnote}{HTML}{F4ECF7}    % note box
\definecolor{vwarn}{HTML}{FDEDEC}    % warning box
\definecolor{vwarnru}{HTML}{E6B0AA}

\color{vink}

