useenv Verbatim [numbers=left, numbersep=5pt, frame=single] {
#::
    local content = read_all("vesti_man.ves")
    for line in content:gmatch("([^\r\n]*)\r?\n?") do
        vesti.print(line)
    end
::#[readAll]
}
