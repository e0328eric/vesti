\fancyhead[R]{\small\color{vhead}\leftmark}
\fancyfoot[C]{\small\color{vink}\thepage}

% ---------------------------------------------------------------------------
%  Inline tokens
% ---------------------------------------------------------------------------
\newcommand{\kw}[1]{{\ttfamily\color{vkw}\bfseries #1}}        % keyword
\newcommand{\bi}[1]{{\ttfamily\color{vbi}\bfseries\##1}}        % builtin
\newcommand{\code}[1]{{\ttfamily #1}}                           % inline code
\newcommand{\meta}[1]{{\normalfont\itshape$\langle$#1$\rangle$}}% metavariable

% ---------------------------------------------------------------------------
%  Listings: a "vesti" language definition
% ---------------------------------------------------------------------------
\lstdefinelanguage{vesti}{
  morekeywords={docclass,importpkg,importves,importmod,startdoc,useenv,%
    begenv,endenv,defun,defenv},
  sensitive=true,
  morecomment=[l]{--},
  morestring=[b]",
}

\lstdefinelanguage{foo}{
  morekeywords={docclass,importpkg,importves,importmod,startdoc,useenv,%
    begenv,endenv,defun,defenv},
  sensitive=true,
  morestring=[b]",
}
\lstdefinestyle{vesti}{
  language=vesti,
  basicstyle=\ttfamily\small\color{vink},
  keywordstyle=\color{vkw}\bfseries,
  commentstyle=\color{vcom}\itshape,
  stringstyle=\color{vstr},
  showstringspaces=false,
  backgroundcolor=\color{vbg},
  frame=single,
  rulecolor=\color{vrule},
  framesep=6pt,
  xleftmargin=10pt,
  xrightmargin=4pt,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  numbers=left,
  numberstyle=\ttfamily\scriptsize\color{vcom},
  numbersep=10pt,
  aboveskip=1.0em,
  belowskip=0.6em,
  literate=
    {\#}{{{\color{vbi}\#}}}1
}

\lstdefinestyle{plainved}{
  language=foo,
  basicstyle=\ttfamily\small\color{vink},
  keywordstyle=\color{vkw}\bfseries,
