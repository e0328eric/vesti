\newtcolorbox{notebox}[1][Note]{
  breakable, enhanced, colback=vnote, colframe=vkw,
  boxrule=0.4pt, arc=2pt, left=8pt, right=8pt, top=5pt, bottom=5pt,
  fonttitle=\bfseries\color{vhead}, title={#1}, coltitle=vhead,
  attach title to upper=\ , before upper={\itshape}}

\newtcolorbox{warnbox}[1][Caution]{
  breakable, enhanced, colback=vwarn, colframe=vwarnru,
