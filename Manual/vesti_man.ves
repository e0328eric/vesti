  fonttitle=\bfseries\color{vhead}, title={#1}, coltitle=vhead,
  attach title to upper=\ }

\newtcolorbox{synbox}{
  breakable, enhanced, colback=white, colframe=vrule,
  boxrule=0.6pt, arc=2pt, left=8pt, right=8pt, top=5pt, bottom=5pt,
  before upper={\ttfamily}}

% Grammar metavariable in synbox
\newcommand{\g}[1]{{\normalfont\itshape$\langle$#1$\rangle$}}
\newcommand{\opt}[1]{#1\textsuperscript{\normalfont\itshape?}}
\newcommand{\rep}[1]{#1\textsuperscript{\normalfont\itshape*}}

% nicer table column
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\hypersetup{colorlinks=true, linkcolor=vlink, urlcolor=vurl}
-%

-- ====================================================================
--  Lua helpers that read the compiler source so that the keyword /
--  builtin / Lua-API tables below regenerate automatically whenever the
--  source changes.  Paths are relative to this file (drop it next to the
--  original Manual/ directory so that ../src/... resolves).
-- ====================================================================
#::
function read_all(path)
    local f, err = io.open(path, "rb")
    assert(f, ("cannot open %s: %s"):format(path, err))
    local data = f:read("*a")
    f:close()
    return data
end

-- collect the first capture of every match of `pat` in `s`,
-- dropping any whose second capture equals `reject`, then sort.
function ves_collect(s, pat, reject)
    local out = {}
    for a, b in s:gmatch(pat) do
        if not (reject and b == reject) then
            out[#!out + 1] = a
        end
    end
    table.sort(out)
    return out
end

-- print a centered tabular of `names`, `cols` wide, each cell rendered
-- through string.format(fmt, name).
function ves_name_table(names, cols, fmt)
    vesti.print("\\begin{tabular}{" .. string.rep("c", cols) .. "}")
    for i, nm in ipairs(names) do
        local cell = string.format(fmt, nm)
        if (i % cols) == 0 then
            vesti.print(cell .. [[\\]])
        else
            vesti.print(cell .. "&")
        end
    end
    vesti.print([[\end{tabular}]])
end
::#*

-- definition of helper commands used to colour vesti terms.
defun [!] keyword (m) {{\tt\color{vkw}\bfseries #1}}
defun [!] builtin (v) {{\tt\color{vbi}\bfseries\##1}}

-- a faux "space" glyph used to indicate where a space is mandatory.
defun ob {\kern2pt{\tt\textvisiblespace}\kern2pt}

startdoc
