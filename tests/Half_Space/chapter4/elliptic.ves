#def #TODO {
    useenv center { \bf{\color{red}[Fill Here!!]} }
}
#def #thm {useenv thm}
#def #lemma {useenv lemma}
#def #remark {useenv remark}
#def #norm { ||#1||_{#2}}
#def #can_norm {#norm(#1)(#2,p,\theta)}
#def #L {\Lc_{#1}}

In the remaining part of the paper we assume that\footnote{
    By the way, this condition gives $(x^1)^{\theta-d}\in A_p$, where $A_p$ is
    the Muckenhoupt class.
}
#eq (eq:4.1) {
    d-1 < \theta < d-1+p
}
(and as always, $p\in(1,oo)$). In this section we are going to consider the
equation
#eq (eq:4.2) {
    \Delta u - \lambda u = D_if^i,
}
where $\lambda$ is a nonnegative constant.

Given $f^i\in H_{p,\theta}^{\gamma-1}$, we look for solutions $u$ on some
appropriate space. Under these circumstances, as we know from
\Cref{remark:2.2,remark:2.15}, equation \cref{eq:4.2} is equivalent to the
equation
#eq (eq:4.3) {
    \Delta u - \lambda u = M^{-1}f,
}
where $f\in H_{p,\theta}^{\gamma-2}$.

If $(f^1,...,f^d)$ for $f^i\in H_{p,\theta}^\gamma$ is given, put $f = MD_if^i$.
Then $f\in H_{p,\theta}^{\gamma-2}$ by \Cref{remark:2.2}.
Conversely, of $f\in H_{p,\theta}^{\gamma-2}$ is fixed, consider $f^i = Q_if$
where $Q_i$ is come from \Cref{defin:2.14}.
Then by \Cref{remark:2.15}, one have $M^{-1}f = \sum_i D_if^i$.

Here is the main result of this section.

#label(thm:4.1) #thm {
    For any $f^i\in H_{p,\theta}^{\gamma-1}$ in the space $MH_{p,\theta}^\gamma$
    there exists a unique solution $u$ of equation \cref{eq:4.2}.
    For this solution we have
    #eq (eq:4.4) {
        \lambda #can_norm(Mu)(\gamma-2) + #can_norm(M^{-1}u)(\gamma)
        <= N(d,\gamma,p,\theta)\sum_i #can_norm(f^i)(\gamma-1).
    }
}

#label(remark:4.2) #remark {
    For equation \cref{eq:4.3} we have the same result assuming that $f\in
    H_{p,\theta}^{\gamma-2}$ and replacing the sum on the right in \cref{eq:4.4}
    with $#can_norm(f)(\gamma-2)$.
}

#label(remark:4.3) #remark {
    If $\theta>=p+d-1$ or $\theta<=d-1$, then the statement of \Cref{thm:4.1}
    is false in general.

    It suffices to show that there is no constant $N$ depends only on
    $d,\gamma,p$, and $\theta$ such that
    #eq (eq:4.3.1) {
        ||M^{-1}u||_{0,p,\theta} <= N||M\Delta u||_{0,p,\theta}.
    }
    This is because by considering $\Delta u = M^{-1}f$ with $\gamma=2$,
    \cref{eq:4.4} becomes
    $$
        ||M^{-1}u||_{2,p,\theta} <= N ||f||_{0,p,\theta} = N ||M\Delta
        u||_{0,p,\theta}.
    $$
    Since it is clear that $||\cdot||_{0,p,\theta} <= ||\cdot||_{2,p,\theta}$,
    we automatically get \cref{eq:4.3.1} if \Cref{thm:4.1} is true.
    In addition, we first assume $d>=2$.

    Consider any nonnegative $g\in C_0^oo(\R^{d-1})$ with $g(x) = 1$ on $|x| <=
    1$, and define $\psi(x) = g*P(x^1,\cdot)(x')$, where $P(t,x)$, $t>0$,
    $x\in\R^{d-1}$ is a Poisson kernel. Finally, take a smooth function $\phi$
    on $\R$ such that $0<=\phi<=1$, $\phi(x)=1$ for $x<=1$, and $\phi(x)=0$ for
    $x>=2$. 

    Assume that $\theta <= d-1$, and consider $u(x) = \phi(x^1)\psi(x)$. Then since
    $\psi$ is harmonic on $\R_+^d$, we have
    $$
        \Delta u(x) = \phi''(x)\psi(x) + 2\phi'(x)\psi_{x^1}(x).
    $$
    This, Fubini's theorem, $\phi'(x) = \phi''(x) = 0$ outside of $(1,2)$, and
    the Young's inequality\footnote{
        See the appendix for the property of Poisson kernel.
    } shows that
    useenv align* {
        ||M\Delta u||_{0,p,\theta}^p
        &<= N\int_{\R_+^d}(x^1)^{\theta-d+p}|\phi''(x)\psi(x)|^pdx
        + N\int_{\R_+^d}(x^1)^{\theta-d+p}|\phi'(x)\psi_{x^1}(x)|^pdx \\
        &<= N\int_1^2\int_{\R^{d-1}}(x^1)^{\theta-d+p}|\phi''(x)\psi(x)|^pdx
        + N\int_1^2\int_{\R^{d-1}}(x^1)^{\theta-d+p}|\phi'(x)\psi_{x^1}(x)|^pdx \\
        &= N\int_1^2(x^1)^{\theta-d+p}|\phi''(x^1)|^p ||\psi(x^1,\cdot)||_p^pdx^1
        + N\int_1^2(x^1)^{\theta-d+p}|\phi'(x^1)|^p
        ||\psi_{x^1}(x^1,\cdot)||_p^pdx^1 \\
        &<= N||g||_p^p||\phi''||_oo\int_1^2(x^1)^{\theta-d+p}dx^1
        + N||g||_p^p||\phi'||_oo\int_1^2(x^1)^{\theta-d} dx^1 \\
        &< oo.
    }
    On the other hand, for any $|x'|<=1$, since
    $$
        |x'-y| <= 2\quad \forall |y|<=1,
    $$
    we find
    useenv align* {
        \psi(x)
        = \int_{\R^{d-1}} g(y) P(x^1,x'-y) dy
        &>= \int_{|y| <= 1} g(y) P(x^1,x'-y) dy \\
        &= \int_{|y| <= 1} P(x^1,x'-y) dy
        >= N(d)\int_{|y| <= 1} {x^1//((x^1)^2+4)^{d/2}} dy
        = N(d){x^1//((x^1)^2+4)^{d/2}}.
    }
    Hence,
    useenv align* {
        ||M^{-1}u||_{0,p,\theta}^p
        &= \int_{\R_+^d} (x^1)^{\theta-d-p}|\phi(x)\psi(x)|^pdx \\
        &= \int_0^2\int_{\R^{d-1}} (x^1)^{\theta-d-p}|\phi(x)\psi(x)|^pdx \\
        &>= \int_0^1\int_{\R^{d-1}} (x^1)^{\theta-d-p}|\phi(x)\psi(x)|^pdx \\
        &= \int_0^1\int_{\R^{d-1}} (x^1)^{\theta-d-p}|\psi(x)|^pdx \\
        &>= \int_0^1\int_{|x'| <= 1} (x^1)^{\theta-d-p}|\psi(x)|^pdx \\
        &>= N(d)\int_0^1 {(x^1)^{\theta-d} // ((x^1)^2+4)^{dp/2}}dx \\
        &>= N(d,p)\int_0^1 {(x^1)^{\theta-d} // ((x^1)^{dp} \vee 2^{dp})} dx \\
        &= N(d,p)\int_0^1 (x^1)^{\theta-d} dx \\
        &= oo
    }
    because $\theta - d <= -1$.
    This proves that \cref{eq:4.3.1} failes to hold if $d>=2$ and $\theta <=
    d-1$.

    Now we are going to observe the case when $\theta >= p - d + 1$ (also
    remember $d>=2$). Define $g_n(x) = g(x/n)$, $\psi_n(x) = g_n *
    P(x^1,\cdot)(x')$.
    Since
    $$
        P(t,nx) = {2t // \omega_d (|nx|^2 + t^2)^{d/2}}
        = {2 n (t/n) // \omega_d (|x|^2 + (t/n)^2)^{d/2}n^d}
        = n^{1-d}P(t/n,x),
    $$
    one can show that
    $$
        \psi_n(x) = n^{d-1}\int_{\R^{d-1}}g(y)P(x^1,x'-ny)dy
        = n^{d-1}(g*P(x^1,n\cdot))(x')
        = \psi(x/n),\quad
        \psi_{nx^1}(x) = n^{-1}\psi_{x^1}(x/n).
    $$
    Thus, by Young's inequality,
    $$
        ||\psi_n(x^1,\cdot)||_p <= N(d,p) n^{(d-1)/p} ||g||_1,\quad
        ||\psi_{nx^1}(x^1,\cdot)||_p <= N(d,p) n^{(d-1)/p} (x^1)^{-1} ||g||_1.
    $$

    Furthermore, since $\psi(x) -> g(x')$ in $L_p$ as $x^1\downarrow 0$, there exists
    $\delta>0$ such that $||\psi(x^1,\cdot)||_p >= ||g||_p/2$ for every
    $|x^1|<=\delta$. We now only consider large $n$, meaning that $n$ should
    satisfy $n\delta > 2$.

    Now define $v_n(x) = (1-\phi(x^1))\psi_n(x) \eqcolon \bar\phi(x^1)\psi_n(x)$.
    Since $\bar\phi'$ and $\bar\phi''$ vanishes outside of $(1,2)$, and $\psi_n$
    is a harmonic function on $\R_+^d$, we have
    useenv align* {
        ||M\Delta v_n||_{0,p,\theta}^p
        &= \int_{\R_+^d}(x^1)^{\theta-d+p}|\bar\phi''\psi_n +
        2\bar\phi'\psi_{nx^1}|^p(x)dx \\
        &<= N\int_1^2 (x^1)^{\theta-d+p} ||\psi_n(x^1,\cdot)||_p^p dx^1 +
        N\int_1^2 (x^1)^{\theta-d+p} ||\psi_{nx^1}(x^1,\cdot)||_p^pdx^1 \\
        &<= Nn^{d-1}||g||_1^p\int_1^2 (x^1)^{\theta-d+p}+(x^1)^{\theta-d}dx^1 \\
        &= N(d,p,\theta,g)n^{d-1}.
    }

    On the other hand, by our chosen $n$, we find
    useenv align* {
        ||M^{-1}v_n||_{0,p,\theta}^p
        &= \int_{\R_+^d}(x^1)^{\theta-d-p}|\bar\phi\psi_n|^p(x)dx \\
        &= \int_2^oo (x^1)^{\theta-d-p} ||\psi_n(x^1,\cdot)||_p^p dx^1 \\
        &= \int_2^oo (x^1)^{\theta-d-p} ||\psi(x^1/n,\cdot/n)||_p^p dx^1 \\
        &= n^{d-1}\int_2^oo (x^1)^{\theta-d-p} ||\psi(x^1/n,\cdot)||_p^p dx^1 \\
        &>= n^{d-1}\int_2^{n\delta} (x^1)^{\theta-d-p} ||\psi(x^1/n,\cdot)||_p^p dx^1 \\
        &>= 2^{-p}n^{d-1}||g||_p^p\int_2^{n\delta} (x^1)^{\theta-d-p}dx^1.
    }
    Indeed for the last inequality, $x^1\in [2,n\delta]$ implies that
    $|x^1/n|<=\delta$, thus $||\psi(x^1/n,\cdot)||_p >= ||g||_p/2$.

    If \cref{eq:4.3.1} were true, we should have
    $$
        2^{-p}n^{d-1}||g||_p^p\int_2^{n\delta}(x^1)^{\theta-d-p}dx^1
        <= ||M^{-1}v_n||_{0,p,\theta}^p
        <= N||M\Delta v_n||_{0,p,\theta}^p
        <= N n^{d-1},
    $$
    where $N$ is independent of $n$. By our chosen $g$, $||g||_p > 0$, thus
    $$
        \int_2^{n\delta}(x^1)^{\theta-d-p}dx^1 <= N < oo
    $$
    where $N$ is a constant independent of $n$. However as we assumed that
    $\theta>=p+d-1$, letting $n->oo$ gives the left hand side integral
    tends to infinity, which is a contradiction.

    For the case $d=1$, counterexamples are much simpler.
    If $\theta <= 0$, then just consider $\phi$ as we discussed in above.
    Indeed, it is easy to show that $||M\Delta\phi||_{0,p,\theta}<oo$ because
    $\Delta\phi = \phi''$ and it is supported in $(0,3)$.
    In addition, $||M^{-1}\phi||_{0,p,\theta}^p >= \int_0^1
    x^{\theta-1-p}dx=oo$.

    If $\theta>=p$, then consider $v(x) = x(1-\phi(x))$. By the similar way,
    $||M\Delta v||_{0,p,\theta}<oo$ because $\Delta v = v''$ and it is also
    supported in $(0,3)$. Furthermore, $||M^{-1}u||_{0,p,\theta}^p >= \int_2^oo
    x^{\theta-1}dx = oo$.
}

#label(remark:4.4) #remark {
    \Cref{lemma:1.9} bearing on change of coordinates shows that \Cref{thm:4.1}
    also holds for the equation
    #eq (eq:4.5) {
        a^{ij}u_{x^ix^j} - \lambda u = D_if^i,
    }
    where $f^i\in H_{p,\theta}^{\gamma-1}$ and $a^{ij}$ is a constant symmetric
    matrix satisfying
    #eq (eq:4.6) {
        \delta_0|\xi|^2 <= a^{ij}\xi^i\xi^j <= \delta_0^{-1}|\xi|^2\quad
        \forall \xi\in\R^d,
    }
    with a constant $\delta_0>0$. In this situation the constant $N$ in
    \cref{eq:4.4} also depends on $\delta_0$.
    As above, \cref{eq:4.5} is equivalent to the equation
    $$
        a^{ij}u_{x^ix^j} - \lambda u = M^{-1}f,
    $$
    where $f\in H_{p,\theta}^{\gamma-2}$.
}

#label(remark:4.5) #remark {
    If $\lambda=0$, then the assertion of \Cref{thm:4.1} follows from
    \Cref{thm:2.16}. Indeed, after substituting $u=Mv$, equation \cref{eq:4.3}
    becomes $\Lc_{2,0}v = f$.
}

#label(remark:4.6) #remark {
    Observe that, if $\lambda>0$, then
    $(\Delta-\lambda)MH_{p,\theta}^\gamma!=M^{-1}H_{p,\theta}^{\gamma-2}$
    because $\Delta MH_{p,\theta}^\gamma=M^{-1}H_{p,\theta}^{\gamma-2}$
    (\Cref{remark:4.5}) and $MH_{p,\theta}^{\gamma-1}\not\subseteq
    M^{-1}H_{p,\theta}^{\gamma-2}$. On the other hand, as we know
    useenv align* {
        ||M(\Delta u-\lambda u)||_{\gamma-2,p,\theta}
        &<= ||MD_iD_iu||_{\gamma-2,p,\theta} + \lambda||Mu||_{\gamma-2,p,\theta}
        \\
        &<= N(||D_iu||_{\gamma-1,p,\theta} + ||Mu||_{\gamma-2,p,\theta}) \\
        &<= N(||M^{-1}u||_{\gamma,p,\theta} + ||Mu||_{\gamma-2,p,\theta}) \\
        &= N||u||_{MH_{p,\theta}^\gamma\cap M^{-1}H_{p,\theta}^{\gamma-2}}.
    }
    Thus, for $\lambda>0$, \Cref{thm:4.1} implies that the operator
    $\Delta-\lambda$ is a bounded 1-1 operator from $MH_{p,\theta}^\gamma\cap
    M^{-1}H_{p,\theta}^{\gamma-2}$ onto $M^{-1}H_{p,\theta}^{\gamma-2}$ and its
    inverse is bounded.
}
    
The proof of this theorem is based on two lemmas.
#label(lemma:4.7) #lemma {
    Let $\theta_1\in\R$, $\mu<=\gamma$, and let $u\in MH_{p,\theta_1}^\mu\cap
    MH_{p,\theta}^\gamma$\footnote{
        $u$ can be a solution to \cref{eq:4.2} on the space
        $MH_{p,\theta_1}^\gamma$ for different $\theta_1!=\theta$.
    } be a solution of \cref{eq:4.2} with $f^i\in H_{p,\theta}^{\gamma-1}$.
    Then $u\in MH_{p,\theta}^\gamma$ and
    #eq (eq:4.7) {
        \lambda #can_norm(Mu)(\gamma-2) + #can_norm(M^{-1}u)(\gamma)
        <= N?(\sum_i #can_norm(f^i)(\gamma-1) + #can_norm(M^{-1}u)(\mu))?,
    }
    where $N=N(d,\gamma,p,\theta)$.\footnote{
        Again, one can replace
        $ \sum_i #can_norm(f^i)(\gamma-1)^p $
        into $#can_norm(f)(\gamma-2)^p$ for $f\in H_{p,\theta}^{\gamma-2}$.
    }
    \proof
    Since $#can_norm(\cdot)(\nu)<=#can_norm(\cdot)(\mu)$ for $\nu<=\mu$,
    it suffices to prove \cref{eq:4.7} with some $\nu<=\mu$ in place of $\mu$.
    This shows that we may assume that $\gamma-\mu$ is an integer.
    Furthermore, inductively, for every positive integer $n$, we have
    useenv align* {
        \lambda #can_norm(Mu)(\gamma-2) + #can_norm(M^{-1}u)(\gamma)
        &<= N?(\sum_i #can_norm(f^i)(\gamma-1) +
        #can_norm(M^{-1}u)(\gamma-1))?\\
        &<= N?(\sum_i #can_norm(f^i)(\gamma-1)
        +\sum_i #can_norm(f^i)(\gamma-2) +
        #can_norm(M^{-1}u)(\gamma-2))?\\
        &<= ... \\
        &<= N?(\sum_i #can_norm(f^i)(\gamma-1) + ...
        +\sum_i #can_norm(f^i)(\gamma-n) +
        #can_norm(M^{-1}u)(\gamma-n))?\\
        &<= N?(\sum_i #can_norm(f^i)(\gamma-1) +
        #can_norm(M^{-1}u)(\gamma-n))?.
    }
    Because of such process, we reduce the general situation to the one with
    $\mu=\gamma-1$.

    Take a function $\zeta\in C_0^oo(\R_+)$ satisfying \cref{eq:1.1}.
    Obviously, the functions $u_n(x) \defeq u(e^nx)$ satisfy the equation
    $$
        \Delta u_n  - e^{2n}\lambda u_n = e^{2n}f_n,
    $$
    where $f_n(x) = (D_if^i)(e^nx)$. In addition, notice that
    $$
        \Delta(\zeta u_n) = \zeta''u_n + \zeta (\Delta u_n) + 2\zeta' u_{nx^1},
    $$
    hence
    #eq (eq:4.8) {
        \Delta(\zeta u_n) - e^{2n}\lambda\zeta u_n = \bar f_n,
    }
    where $\bar f_n = \zeta e^{2n}f_n - 2\zeta'u_{nx^1} - u_n\zeta''$.
    #def #f {\bar f_n}
    Remember that $\eta u_n = H_p^\mu = H_p^{\gamma-1}$ for any $\eta\in
    C_0^oo(\R_+)$. It follows that $#f\in H_p^{\gamma-2}$.
    Also notice that \cref{eq:4.8} holds in the entire space $\R^d$.
    We now prove that $\zeta u_n\in H_p^\gamma$ and
    #eq (eq:4.9) {
        \lambda e^{2n}||\zeta u_n||_{\gamma-2,p}
        + ||(\zeta u_n)_{xx}||_{\gamma-2,p}
        <= N||#f||_{\gamma-2,p}.
    }
    By the classical result (see, for instance, Section 9.4 of \cite{Tru} or
    Theorem 4.3.7 of \cite{Kry5}), it follows that $||v_{xx}||_p <= N||\Delta
    u||_p$ for $v\in H_p^2$.\footnote{
        Actually, \cite{Tru} only proves those with compactly supported.
        However we can drop that condition because $C_0^oo(\R^d)$ is dense in
        $H_p^2$.
    } Replacing $v$ with $(1-\Delta)^{(\gamma-2)/2}v$ we get
    useenv align* {
        ||v_{xx}||_{\gamma-2,p}
        &= ||(1-\Delta)^{(\gamma-2)/2}D^2v||_{p} \\
        &= ||D^2(1-\Delta)^{(\gamma-2)/2}v||_{p} \\
        &<= N||\Delta(1-\Delta)^{(\gamma-2)/2}v||_{p} \\
        &<= N||(\Delta-\lambda)(1-\Delta)^{(\gamma-2)/2}v||_{p}
        + N\lambda||(1-\Delta)^{(\gamma-2)/2}v||_{p} \\
        &= N||\Delta v-\lambda v||_{\gamma-2,p} + N\lambda||v||_{\gamma-2,p}.
    }
    To get \cref{eq:4.9}, it only remains to notice that
    $v=(\Delta-\lambda)^{-1}[(\Delta-\lambda)v]$, and
    $||(\Delta-\lambda)^{-1}||_{H_p^\gamma->H_p^{\gamma+2}} =
    \lambda^{-1}$.\footnote{
        The proof of which is presented in appendix.
    }
    Put $e^{2n}\lambda$ instead of $\lambda$, therefore, gives
    useenv align* {
        \lambda e^{2n}||\zeta u_n||_{\gamma-2,p}
        + ||(\zeta u_n)_{xx}||_{\gamma-2,p}
        &<= N||\Delta(\zeta u_n) - \lambda e^{2n}\zeta u_n||_{\gamma-2,p}
        + N\lambda e^{2n}||\zeta u_n||_{\gamma-2,p} \\
        &<= N||\Delta(\zeta u_n) - \lambda e^{2n}\zeta u_n||_{\gamma-2,p} \\
        &= N||#f||_{\gamma-2,p}.
    }

    Furthermore, by \Cref{remark:1.13}, we have
    $$
        N||(\zeta u_n)_{xx}||_{\gamma-2,p}
        >= ||(\zeta u_n)_{x}||_{\gamma-1,p}
        >= ||\zeta u_{nx}||_{\gamma-1,p} - ||u_n\zeta'||_{\gamma-1,p}.
    $$
    Also we use identities like
    $$
        u_{nx}(x) = e^n u_x(e^nx),\quad
        e^{-n}u_n\zeta_x(x) = (M^{-1}u)(e^nx)M\zeta'(x),
    $$
    and from \cref{eq:4.9} we get
    useenv align* {
        &\lambda||(Mu)(e^n\cdot)M^{-1}\zeta||_{\gamma-2,p}
        + ||u_x(e^n\cdot)\zeta||_{\gamma-1,p} \\
        &\kern2cm= \lambda||e^nu_n\zeta||_{\gamma-2,p}
        + ||e^{-n}u_{nx}\zeta||_{\gamma-1,p} \\
        &\kern2cm<= \lambda||e^nu_n\zeta||_{\gamma-2,p}
        + ||e^{-n}u_{n}\zeta'||_{\gamma-1,p}
        + N||e^{-n}(\zeta u_{n})_{xx}||_{\gamma-2,p} \\
        &\kern2cm<= N||e^{-n}#f||_{\gamma-2,p} +
        ||e^{-n}u_n\zeta'||_{\gamma-1,p} \\
        &\kern2cm<= N?(
            ||e^{-n}u_n\zeta'||_{\gamma-1,p}
            +||e^{n}f_n\zeta||_{\gamma-2,p}
            +||e^{-n}u_{nx^1}\zeta'||_{\gamma-2,p}
            +||e^{-n}u_{n}\zeta''||_{\gamma-2,p}
        )? \\
        &\kern2cm= N?(
            ||(M^{-1}u)(e^n\cdot)M\zeta'||_{\gamma-1,p}
            +||(MD_if^i)(e^n\cdot)M^{-1}\zeta||_{\gamma-2,p} .? \\
            &\kern3cm ?.+||u_{x^1}(e^n\cdot)\zeta'||_{\gamma-2,p}
            +||(M^{-1}u)(e^n\cdot)M\zeta''||_{\gamma-2,p}
        )?.
    }
    After taking this inequality to the $p$th power then multiplying through by
    $e^{n\theta}$, summing up over $n$, and using \Cref{lemma:1.4}, we conclude
    first that
    $$
        \lambda^p\sum_{n=-oo}^oo e^{n\theta}||(Mu)(e^n\cdot)M^{-1}\zeta||_{\gamma-2,p}^p +
        #can_norm(u_x)(\gamma-1)^p
        <= N(#can_norm(MD_if^i)(\gamma-2)^p
        +#can_norm(u_x)(\gamma-2)^p + #can_norm(M^{-1}u)(\gamma-1)^p).
    $$
    Observe that in order to prove \Cref{lemma:1.4}, the sufficient condition
    for $\zeta$ is
    $$
        \sum_{n=-oo}^oo \zeta^p(e^{x-n}) > 0.
    $$
    Notice that $M^{-1}\zeta$ also satisfies that condition, so we can apply
    \Cref{lemma:1.4} for $\zeta$ and $M^{-1}\zeta$ in place of $\eta$ and
    $\zeta$ to obtain\footnote{
        Additionally, we used
        $$
            \sum_1^n a_j^p <= ?(\sum_1^n a_j)?^p <= n^p \sum_1^n a_j^p
        $$
        where $p\in[1,oo)$ and $a_j>=0$.
    }
    $$
        \lambda #can_norm(Mu)(\gamma-2) + #can_norm(u_x)(\gamma-1)
        <= N(#can_norm(MD_if^i)(\gamma-2)
        +#can_norm(u_x)(\gamma-2) + #can_norm(M^{-1}u)(\gamma-1)).
    $$
    It only remains to remember that $MD_i$ are bounded operators from
    $H_{p,\theta}^{\gamma-1}$ to $H_{p,\theta}^{\gamma-2}$ and that the norms
    $#can_norm(u_x)(\nu)$ and $#can_norm(M^{-1}u)(\nu+1)$ are equivalent.
    The lemma is proved.
}
#undef #f
#undef #can_norm
#def #n {#norm(#1)(#2,p,\theta)}
#def #hh { H_{p,#2}^{#1}}
#def #h { H_{p,\theta}^{#1}}
#def #ll { L_{p,#1}}
#def #l { L_{p,\theta}}

#label(lemma:4.8) #lemma {
    \Cref{thm:4.1} holds if $\gamma=2$.
    \proof
    By \Cref{remark:4.5}, we may concentrate on the case $\lambda > 0$.
    First we prove the a priori estimate: for any $u\in MH_{p,\theta}^2$ we have
    #eq (eq:4.10) {
        \lambda #n(Mu)(0) + #n(M^{-1}u)(2)
        <= N(d,p,\theta)#n(M(\Delta u - \lambda u))(0).
    }

    Of course, we only need to prove \cref{eq:4.10} assuming that $\Delta
    u-\lambda u = M^{-1}f$ with $f\in L_{p,\theta}$ (otherwise the right-hand
    side is infinite).

    In this case, by \Cref{lemma:4.7} we have $u\in M#h(2)\cap M^{-1}#l$.
    Observe that, by \Cref{coro:1.6}, we have $M#h(2) = #hh(2)(\theta-p)$ and
    (obvioisly) $M^{-1}#l=#ll(\theta+p)$. By \Cref{remark:1.21} the set
    $C_0^oo(\R_+^d)$ is everywhere dense in $M#h(2)\cap M^{-1}#l$. Since
    $\Delta-\lambda$ is bounded operator from the latter space to $M^{-1}#l$
    (\Cref{remark:4.6}), we conclude that we only need to prove \cref{eq:4.10}
    for $u\in C_0^oo(\R^d_+)$.

    In this case consider $v\defeq M^{-1}u\in C_0^oo(\R_+^d)$.
    Since
    useenv align* {
        D_{x^i}v &= M^{-1}u_{x^i} - \delta^{1i}M^{-2}u; \\
        D_{x^ix^j}v &= M^{-1}u_{x^ix^j}
        - \delta^{1i}M^{-2}u_{x^j}
        - \delta^{1j}M^{-2}u_{x^i}
        + 2\delta^{1i}\delta^{ij}M^{-3}u,
    }
    we have
    $$
        #L(2,0)v = (M^2\Delta + 2MD_1)v = M\Delta u, \quad
        #L(2,0)v - \lambda M^2v = f.
    $$
    In the same way as in the proof of
    \Cref{thm:2.16} we get $#n(v)(0)<=\kappa^{-1}#n(f)(0)$ with $\kappa\defeq
    p^{-2}(\theta-d+1)(p+d-1-\theta)$.
    Indeed, similarly one can obtain with $w\defeq |v|^{p/2}$ and
    $$
        {(\theta-d+1)^2//4}||v||_{0,p,\theta}^p
        <= \int_{\R_+^d}(x^1)^{\theta-d+2}|w_{x^1}|^2dx,
    $$
    we have
    useenv align* {
        ||f||_{0,p,\theta}||v||_{0,p,\theta}^{p-1}
        &>= \int_{\R_+^d}(x^1)^{\theta-d}|v|^{p-1}|f|dx \\
        &>= -\int_{\R_+^d}(x^1)^{\theta-d}|v|^{p-2}vfdx \\
        &>= 4p^{-2}(p-1)\int_{\R_+^d}(x^1)^{\theta-d+2}|w_x|^2dx \\
        &\kern1cm+ p^{-1}(\theta-d+1)(d-\theta)\int_{\R_+^d}(x^1)^{\theta-d}|v|^pdx
        + \lambda\int_{\R_+^d}(x^1)^{\theta-d+2}|v|^pdx \\
        &>= 4p^{-2}(p-1)\int_{\R_+^d}(x^1)^{\theta-d+2}|w_x|^2dx
        + p^{-1}(\theta-d+1)(d-\theta)||v||_{0,p,\theta}^p \\
        &>=
        p^{-1}(\theta-d+1)(p^{-1}(p-1)(\theta-d+1)+d-\theta)||v||_{0,p,\theta}^p
        \\
        &= \kappa||v||_{0,p,\theta}^p.
    }

    Upon remembering that $v=M^{-1}u$ and using \Cref{lemma:4.7} with $\mu=0$,
    we arrive at \cref{eq:4.10}.

    Now we are going to prove the existence and the uniqueness of \cref{eq:4.3}.
    Of course, estimate \cref{eq:4.10} implies the uniqueness.
    Owing to \cref{eq:4.10}, to prove the existence, we may assume that in
    \cref{eq:4.3} we have $f\in C_0^oo(\R_+^d)$.
    Indeed, for $f\in L_{p,\theta}$, take a sequence $(f_n)_n$ in
    $C_0^oo(\R_+^d)$ such that $f_n->f$.
#def #space { MH_{p,\theta}^2\cap M^{-1}L_{p,\theta}}
    Take $u_n\in#space$ solves
    $$
        \Delta u_n - \lambda u_n = M^{-1}f_n.
    $$
    Then \cref{eq:4.10} implies that $(u_n)_n$ is Cauchy sequence in $#space$,
    take the limit point $u\in#space$. By \Cref{remark:4.6}, we therefore have
    $$
        M^{-1}f = \lim_{n->oo}M^{-1}f_n
        = \lim_{n->oo}(\Delta-\lambda)u_n = (\Delta - \lambda)u,
    $$
    which proves the existence for the general case.
#undef #space

    If $f\in C_0^oo(\R^d_+)$, continue $f$ to $\R^d$ to be an odd function with
    respect to $x^1$ and solve \cref{eq:4.3} in $\R^d$ to get a bounded
    infinitely differentiable solution $u$. By uniqueness for equation
    \cref{eq:4.3} in $\R^d$,\footnote{
        As $\lambda>0$, we know that $(\lambda-\Delta)^{-1}$ is well-defined on
        $\Sc$, a collection of all Schwartz functions.
    } the function $u$ is odd with respect to $x^1$.
    Hence $u(0,x') = 0$.
    
    Also $u$ itself and all derivatives of $u$ are known to
    be bounded and tends to zero as $|x| -> oo$ exponentially fast $(\lambda >
    0)$.\footnote{
        We will prove this in \cref{sec:lemma:4.8}. Beware that we cannot argue
        that $u$ is a Schwartz function. Although every Schwartz function
        decreases to zero at infinity, its speed is fast than all polynomials.
        However this does not mean that the speed is exponential.
    }
    
    Now we are going to prove that $M^{-1}u\in H_{p,\theta}^2$. To prove this,
    we need a following inequality which can be proved by the fundamental
    theorem of calculus:
    $$
        ?|{u(x) // x^1}|?
        <= \int_0^1 |u_{x^1}(tx^1,x')|dt
        <= \sup_{0<=y<=1} |u_x(y,x')|\quad \forall x^1\in(0,1).
    $$
    Notice that $2|x| = (|x^1|^2+|x'|^2)^{1/2} >= |x^1|+|x'|$. This
    and the calculation as in \cref{sec:lemma:4.8} gives
    $$
        |u_{x}(y,x')| + |u_{xx}(y,x')| <= Ne^{-\mu|(y,x')|}
        <= Ne^{-\mu(|y|+|x'|)/2},\quad
        \sup_{x^1\in(0,1)} ?|{u(x) // x^1}|? <= N e^{-\mu|x'|/2}.
    $$
    Therefore, since $d-1 < \theta < p+d-1$, and $\theta-d+p = (\theta-d+1)+(p-1) >
    p-1 > 0$, we obtain
    useenv align* {
        \int_{\R_+^d}(x^1)^{\theta-d} |u(x)/x^1|^pdx
        &= \int_{x^1 < 1}(x^1)^{\theta-d} |u(x)/x^1|^pdx
        + \int_{x^1 >= 1}(x^1)^{\theta-d} |u(x)/x^1|^pdx \\
        &= \int_{x^1 < 1}(x^1)^{\theta-d} |u(x)/x^1|^pdx
        + \int_{x^1 >= 1}(x^1)^{\theta-d-p} |u(x)|^pdx \\
        &<= N\int_0^1\int_{\R^{d-1}} t^{\theta-d}e^{-\mu|y|/2}dydt
        + N\int_1^oo\int_{\R^{d-1}} t^{\theta-d-p}e^{-\mu(t+|y|)/2}dydt \\
        &< oo,
    }
    $$
        \int_{\R_+^d}(x^1)^{\theta-d} |u_x(x)|^pdx
        <= N\int_0^1\int_{\R^{d-1}} t^{\theta-d}e^{-\mu|y|/2}dydt
        + N\int_1^oo\int_{\R^{d-1}} t^{\theta-d-p}e^{-\mu(t+|y|)/2}dydt
        < oo.
    $$
    $$
        \int_{\R_+^d} (x^1)^{\theta-d} |x^1u_{xx}(x)|^pdx
        <= N \int_0^oo\int_{\R^{d-1}} t^{\theta-d+p}e^{-\mu(t+|y|)/2}dydt
        < oo.
    $$
    
    This proves that $M^{-1}u,\ u_x,\ Mu_{xx}\in L_{p,\theta}$.
    Now we are going to use \Cref{coro:2.3}. Since
    $$
        MD_i(M^{-1}u)
        = u_{x^i} - \delta^{1i}M^{-1}u \in L_{p,\theta},\quad
        M^2D_iD_j(M^{-1}u)
        = MD_{ij}u - \delta^{1i}D_ju - \delta^{1j}D_iu
        + 2\delta^{1i}\delta^{1j}M^{-1}u \in L_{p,\theta},
    $$
    we, therefore, prove that $M^{-1}u\in H_{p,\theta}^2$.
    In conclusion, we have found the solution of \cref{eq:4.3} in
    $MH_{p,\theta}^2$ and the lemma is proved.
}

\goodbreak
useenv pf [\Cref{thm:4.1}] {
    We split two cases: $\gamma>=2$ and $\gamma<2$.

    \noindent\it{Case $\gamma>=2$}. The uniqueness follows from \Cref{lemma:4.8}
    and the fact that $H_{p,\theta}^\gamma\subset H_{p,\theta}^2$, which implies
    that the difference of two solutions belongs to $H_{p,\theta}^2$ and thus
    coincide because of the uniqueness when $\gamma=2$. The existence and
    estimate \cref{eq:4.4} follows from \Cref{lemma:4.8} and \Cref{lemma:4.7}
    (applied with $\mu=2$) and the observation that by \Cref{lemma:4.8} we have
    $$
        #n(M^{-1}u)(2) <= N\sum_i#n(f^i)(1) <= N\sum_i#n(f^i)(\gamma-1).
    $$

    \noindent\it{Case $\gamma<2$}. Denote by $\Rc_\lambda$ the operator which maps
    $(f^1,...,f^d)$ with $f^i\in H_{p,\theta}^{\gamma-1}$ into the solution
    $u\in MH_{p,\theta}^\gamma$ of equation \cref{eq:4.2}.
    So far we know that $\Rc$ is well-defined in spaces
    $(H_{p,\theta}^{\gamma-1})^d$ for $\gamma>=2$. We want to show that one can
    also defined $\Rc$ for $\gamma<2$.

    First, let $2>\gamma>=1$. Take a $b$ satisfying condition \cref{eq:2.13} and
    observe that by \Cref{thm:2.11} we have $\Lc_{b,0}^{-1}f^i\in
    H_{p,\theta}^{\gamma+1}$. Since $\gamma+1>=1$, by what we know in the case
    $\gamma>=2$, the function
    $$
        v = \Rc_\lambda(\Lc_{b,0}^{-1}f^1,...,\Lc_{b,0}^{-1}f^d)
    $$
    is well-defined and belongs to
    $MH_{p,\theta}^{\gamma+2}=H_{p,\theta-p}^{\gamma+2}$. Let $\tilde u =
    \Lc_{b,0}v$. By \Cref{remark:2.2}, we have $\tilde u \in
    H_{p,\theta-p}^\gamma = MH_{p,\theta}^\gamma$.
    Furthermore, by the definition $v$ satisfies $\Delta v - \lambda v =
    D_i\Lc_{b,0}^{-1}f^i$. We apply $\Lc_{b,0}$ to both parts of this equality
    to get
    #eq (eq:4.11) {
        \Delta\tilde u - \lambda\tilde u = D_if^i + \bar f,
    }
    where
    $$
        \bar f = \Delta\Lc_{b,0}v - \Lc_{b.0}\Delta v +
        \Lc_{b,0}D_i\Lc_{b,0}^{-1}f^i - D_if^i.
    $$
    Next, we use
    $$
        \Lc_{b,0}D_i\phi = D_i\Lc_{b,0}\phi - 2\delta^{1i}M^{-1}\Lc_{b/2,0}\phi,
    $$
    $$
        \Lc_{b,0}D_iD_j\phi = D_iD_j\Lc_{b,0}\phi -
        2\delta^{1j}D_iM^{-1}\Lc_{b/2,0}\phi -
        2\delta^{1i}M^{-1}\Lc_{b/2,0}D_j\phi.
    $$
    We also use \Cref{remark:2.2} and Corollaries \ref{coro:2.5} and
    \ref{coro:2.12} and get
    $$
        \bar f = 2D_1M^{-1}\Lc_{b/2,0}M(M^{-1}v) + 2M^{-1}\Lc_{b/2,0}D_1v -
        2M^{-1}\Lc_{b/2,0}\Lc^{-1}_{b,0}f^1,
    $$
    $$
        ||M\bar f||_{\gamma-1,p,\theta} <=
        N(||M^{-1}v||_{\gamma+2,p,\theta}+||f^1||_{\gamma-1,p,\theta}).
    $$

    We see that $M\bar f\in H_{p,\theta}^{\gamma-1}$, which by
    \Cref{remark:2.15} implies that $\bar f = D_i\bar f^i$ with $||\bar
    f^i||_{\gamma,p,\theta}<=N||M\bar f||_{\gamma-1,p,\theta}$. Since
    $\gamma>=1$, by the result for $\gamma>=2$, the function $\bar
    u\defeq\Rc_\gamma(\bar f^1,...,\bar f^d)$ is well-defined and belongs to
    $MH_{p,\theta}^{\gamma+1}$. To prove existence, it now remains only to
    notice that obviously $\tilde u - \bar u$ belongs to
    $MH^{\gamma}_{p,\theta}$ and solves \cref{eq:4.2} because of \cref{eq:4.11}
    and
    $$
        \Delta\bar u - \lambda\bar u = D^i\bar f^i = \bar f.
    $$
    To prove the estimate \cref{eq:4.4}, notice that by the definition of $v$
    and $\Rc_\lambda$,
    useenv align* {
        \lambda ||M\tilde u||_{\gamma-2,p,\theta} + ||M^{-1}\tilde u||_{\gamma,p,\theta}
        &<= \lambda N||\tilde u||_{\gamma-2,p,\theta+p}
        + ||\tilde u||_{\gamma,p,\theta-p} \\
        &= \lambda N||\Lc_{b,0} v||_{\gamma-2,p,\theta+p}
        + ||\Lc_{b,0} v||_{\gamma,p,\theta-p} \\
        &<= \lambda N||v||_{\gamma,p,\theta+p}
        + ||v||_{\gamma+2,p,\theta-p} \\
        &<= \lambda N||Mv||_{\gamma,p,\theta} + ||M^{-1}v||_{\gamma+2,p,\theta} \\
        &<= N\sum_i||\Lc_{b,0}^{-1}f^i||_{\gamma+1,p,\theta} \\
        &<= N\sum_i||f^i||_{\gamma-1,p,\theta};
    }
    useenv align* {
        \lambda ||M\bar u||_{\gamma-2,p,\theta} + ||M^{-1}\bar u||_{\gamma,p,\theta}
        &<= N\sum_i||\bar f^i||_{\gamma-1,p,\theta} \\
        &<= N\sum_i||\bar f^i||_{\gamma,p,\theta} \\
        &<= N||M\bar f||_{\gamma-1,p,\theta} \\
        &<= N(||M^{-1}v||_{\gamma+2,p,\theta}+||f^1||_{\gamma-1,p,\theta}) \\
        &<= N(||f^1||_{\gamma-1,p,\theta} +
        \sum_i||\Lc_{b,0}^{-1}f^i||_{\gamma+1,p,\theta}) \\
        &<= N \sum_i||f^i||_{\gamma-1,p,\theta};
    }
    useenv align* {
        \lambda ||Mu||_{\gamma-2,p,\theta} + ||M^{-1}u||_{\gamma+1,p,\theta}
        &<= (\lambda ||M\tilde u||_{\gamma-2,p,\theta} + ||M^{-1}\tilde
        u||_{\gamma,p,\theta}) +
        (\lambda ||M\bar u||_{\gamma-2,p,\theta} + ||M^{-1}\bar
        u||_{\gamma,p,\theta}) \\
        &<= N \sum_i||f^i||_{\gamma-1,p,\theta}.
    }

    By repeating the above argument, we consider the case $1>\gamma>=0$, this
    time using the fact that $\gamma+1>=1$ and relying upon the result for
    $\gamma>=1$. One can continue in the same way and it only remains to prove
    the uniqueness of solutions in $MH_{p,\theta}^\gamma$.

    It suffices to consider the case $f=0$ (and $\gamma<2$). In this case any
    solution $u\in MH_{p,\theta}^\gamma$ also belongs to $MH_{p,\theta}^2$ by
    \Cref{lemma:4.7} and its uniqueness follows from \Cref{lemma:4.8}. The
    theorem is thus proved.
}

useenv remark {
    From the above derivation of \Cref{thm:4.1} from \Cref{lemma:4.8} it is seen
    that for \it{any} fixed $\gamma,p,\theta$ satisfying the conditions of
    \Cref{thm:4.1}, if the assertion of \Cref{thm:4.1} holds for these
    particular $\gamma,p,\theta$, then it holds for any $\gamma\in\R$ with the
    same $p,\theta$.
}

