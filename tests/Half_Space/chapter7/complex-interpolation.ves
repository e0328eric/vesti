In this subsection, we are going to prove the following theorem by two
different method.

#label(thm:complex-interpolation)
useenv thm {
    For $\kappa\in(0,1)$, $p\in(1,oo)$, $\gamma_i,\theta_i\in\R$, $i=0,1$,
    $$
        \theta = \kappa\theta_1 + (1-\kappa)\theta_0,\quad
        \gamma = \kappa\gamma_1 + (1-\kappa)\gamma_0,
    $$
    we have $[H_{p,\theta_0}^{\gamma_0},H_{p,\theta_1}^{\gamma_1}]_\kappa =
    H_{p,\theta}^\gamma$, where $[\cdot,\cdot]_\kappa$ denotes the complex
    interpolation.
}

\subsubsection{The direct method}
Below proof is in \cite{Kry6}. In this paper, we fill some details where the
main paper does not mention.

Before proving \Cref{thm:complex-interpolation}, we need a special holomorphic
operator, $(1-\Delta)^z$. The following lemma states precisely.
#label(lemma:holomorphic-op)
useenv lemma {
    For any $f\in\Sc(\R^d)$, the function $g(z) = (1-\Delta)^z f$ is
    $L_2(\R^d)$-valued entire function.
}
In order to prove this lemma, we need another lemma.
#label(lemma:holo-preserve)
useenv lemma {
    Let $X$, $Y$ be complex Banach spaces, $f$ be a $X$-valued holomorphic
    function on a domain $\Omega\subset\C$, and $\Lambda \in L(X,Y)$.
    Then $\Lambda f$ is $Y$-valued holomorphic function on $\Omega$ and
    $(\Lambda f)' = \Lambda f'$.
    \proof
    Fix $z_0\in\Omega$.
    Then we have
    $$
        useenv aligned {
        ?|| {(\Lambda f)(z_0+h) - (\Lambda f)(z_0) // h} - (\Lambda f')(z_0)
        ||?_Y
        &= ?|| \Lambda ?({f(z_0+h) - f(z_0) // h} - f'(z_0) )? ||?_Y \\
        &<= ||\Lambda||_{X->Y} ?|| {f(z_0+h) - f(z_0) // h} - f'(z_0) ||?_X \\
        &->0
        }
    $$
    as $|h| ->0$. This proves the lemma
}

useenv pf [\Cref{lemma:holomorphic-op}] {
    By \Cref{lemma:holo-preserve}, it suffices to show that $\hat g(z) =
    (1+|\xi|^2)^z\hat f(\xi)$ is $L_2(\R^d)$-valued entire function.
}

\subsubsection{Using Interpolation Theories}
