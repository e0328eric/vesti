in the same way as in the proof of Lemma 4.2 of \cite{half-line},
using boundedness of all derivatives of $u$ with respect to $x$, we will
prove that 
$$
    M^{-1}u\in\Hb_{p,\theta}^\gamma(T)\quad
    \forall\gamma>=0,\ \theta\in(d-1,p+d-1).
$$

Since $f$ has a compact support, there exists $r>0$ such that the support of
$f$ lies in the domain
$$
    \Omega \defeq (2r,r^{-1}) \times \{x : |x'| < r^{-1}\}.
$$
First of all, we want to evaluate $||M^{-1}u||_{\Lb_{p,\theta}}$ on the
following subregions (actually $III$ and $IV$ are symmetric).
useenv figure [ht] {
\centering
useenv tikzpicture {
    \draw[thick] (0,0) --! (0,2) node[above] {$x^1$};
    \fill[black!10] (-1,0) rectangle (1,1);
    \draw[thick] (-2,0) --! (2,0);
    \draw[densely dashed] (-2,1) --! (2,1) node[right] {$r$};
    \draw[densely dashed] (-1,0) node[below] {$-r^{-1}$} --! (-1,1);
    \draw[densely dashed] (1,0)  node[below] {$r^{-1}$} --! (1,1);
    \path (1,1.5) node {$I$};
    \path (0,0.5) node {$II$};
    \path (1.5,0.5) node {$III$};
    \path (-1.5,0.5) node {$IV$};
}}

Notice that then $u_t = \Delta u$ outside of $\Omega$ with zero initial and zero
boundary value for $x^1 = 0$. If we set $u(t,x)=0$ for $t<0$, then it satisfies
the heat equation for all $t<=T$ and $x\in\R_+^d-!\Omega$.
Similar method in the proof of Lemma 4.2 of \cite{half-line} gives that
for any multiindex $\alpha$,
#eq (eq:maximum-principles) {
    \sup_{0<x^1<r,|x'|<r^{-1},t<=T}|D^\alpha u(t,x)|
    <= {N(\alpha)//r^{|\alpha|}}\sup_{x^1=2r,|x'|=2r,t<=T}|u(t,x)|.
}
By \cref{eq:maximum-principles},\footnote{
    In addition, $|M^{-1}u|<=\sup|u_x|$.
}
useenv align* {
    \int_0^T\int_{(0,r)\times\{|x'|<r\}}(x^1)^{\theta-d}|M^{-1}u(t,x)|^pdxdt
    &<= N\sup_{x^1=2r,|x'|=2r,t<=T}|u(t,x)|^p
    \int_0^T\int_{(0,r)\times\{|x'|<r\}}(x^1)^{\theta-d}dxdt \\
    &<= NTr^d\sup_{x^1=2r,|x'|=2r,t<=T}|u(t,x)|^p
    \int_0^1(x^1)^{\theta-d}dx^1.
}
Since $\theta>d-1$, the right-hand side integral is finite. Upon translating
with respect to $x'$, applying same argument, and sum them up shows,
therefore, that
$$
    \int_0^T\int_{II}(x^1)^{\theta-d}|M^{-1}u(t,x)|^pdxdt
    <= NTr^d\sup_{x\in II',t<=T}|u(t,x)| \int_0^1(x^1)^{\theta-d}dx^1
    <= N(d,\theta,T,f) < oo
$$
where $II'$ is some subset of $\R_+^d$ containing $II$ and disjoint with
$I$.
In addition, as $(x^1)^{\theta-d-p}<=1$ if $x^1>=1$, we have
useenv align* {
    \int_0^T\int_{I}(x^1)^{\theta-d}|M^{-1}u(t,x)|^pdtdx
    <= \int_0^T\int_{I}|u(t,x)|^pdtdx <=
    T\sup_{t<=T}||u(t,\cdot)||_{L_p}^p < oo,
}
because $u\in C([0,T],L_p)$.

The tricky part is to estimate $III$. By the translation with respect to $x'$,
we can obtain the same inequality \cref{eq:maximum-principles} with $r$ replaced
by $nr^{-1}$ for $n=1,2,...$. Since $u$ is bounded because of the Sobolev
embedding theorem, for $n=1,2,...$ that
useenv align* {
    \int_0^T\int_{(0,r)\times\{nr^{-1}<= |x'|<= (n+1)r^{-1}\}}
    (x^1)^{\theta-d}|M^{-1}u(t,x)|^pdxdt
    &<= {N//n^p}\sup_{t,x} |u|^p
    \int_0^T\int_{(0,r)\times\{nr^{-1}<= |x'|<=
    (n+1)r^{-1}\}}(x^1)^{\theta-d}dxdt \\
    &<= {N//n^p}\sup_{t,x}|u|^p\int_0^1 (x^1)^{\theta-d}dx^1.
}
Since $p > 1$, summing up with respect to $n$ gives a finite estimate on $III$.
Notice that $IV$ is same, therefore, $M^{-1}u\in\Lb_{p,\theta}(T)$.
Similarly, one can prove that for every multiindex $\alpha$, (by the induction
over $|\alpha|$)
$$
    \int_0^T\int_{\R_+^d}(x^1)^{\theta-d}|M^{|\alpha|-1}D^\alpha u|dxdt <
    oo,
$$
which proves $M^{-1}u\in\Hb_{p,\theta}^\gamma(T)$ for every nonnegative $\gamma$
by \Cref{coro:2.3}.

\Cref{remark:5.2} shows that the same inclusions are true for $u_x$ and by
\Cref{remark:2.2} they also hold for $Mu_{xx}$. Finally, from \cref{eq:5.1},
it follows that $Mu_t\in\Hb_{p,\theta}^\gamma(T)$ for all $\gamma$.
Thus $u\in\Hf_{p,\theta}^2(T)$ and applying \Cref{lemma:6.3} we finish the
proof of \Cref{lemma:5.7}.

