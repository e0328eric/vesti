#def #TODO {useenv center { \bf{\color{red}[#1]}} }
Before proving the remark, we need an important lemma.

#label(lemma:approx-operators)
useenv lemma {
    Define $X = \bigcup_{\gamma,p,\theta}H_{p,\theta}^\gamma$.
    There exists operators $\Lambda_n$, $\Lambda_{m,n}$, and
    $\Lambda_{l,m,n}$ from $X$ into $X$ such that
    #enum ((\roman*)) {
        \item For any $u\in H_{p,\theta}^\gamma$, $\Lambda_{l,m,n} u\in
        C_0^oo(\R_+^d)$;
        \item We have
        $$
            \sup_{l,m}(||\Lambda_{m,n}||_{H_{p,\theta}^\gamma->H_{p,\theta}^\gamma} +
            ||\Lambda_{l,m,n}||_{H_{p,\theta}^\gamma->H_{p,\theta}^\gamma}) <=
            N(n),
        $$
        and
        $$
            \sup_{n} ||\Lambda_n||_{H_{p,\theta}^\gamma->H_{p,\theta}^\gamma}
            <= N.
        $$
        \item $\lim_{l->oo}\Lambda_{l,m,n}u = \Lambda_{m,n}u$,
        $\lim_{m->oo}\Lambda_{m,n}u = \Lambda_n u$, and
        $\lim_{n->oo}\Lambda_n u = u$ in $H_{p,\theta}^\gamma$.
        \item Let $u : \R -> H_{p,\theta}^\gamma$ such that $u$ has a distributional
        derivative in $t$, that is if there exists $f$ such
        that
        $$
            (u(t,\cdot),\psi) = (u(0,\cdot),\psi) + \int_0^t (f(s,\cdot),\phi)ds
        $$
        for every $t$ and $\psi\in C_0^oo(\R_+^d)$. In this case, we write $u_t = f$.
        Then
        $$
            (\Lambda_n u)_t = \Lambda_n u_t,\quad
            (\Lambda_{m,n} u)_t = \Lambda_{m,n} u_t,\quad
            (\Lambda_{l,m,n} u)_t = \Lambda_{l,m,n} u_t.
        $$
    }
    \proof
    We first assume that $\gamma$ be a nonnegative integer.
    Fix $\xi\in C_0^oo(\R^d)$ such that $0<=\xi<=1$, $\xi\equiv 1$ on $|x|<=1$
    and $\xi$ vanishes on $|x|>=2$. Then put $\xi_R(x) = \xi(x/R)$ for $R>=1$.
    Then since $\gamma$ is a nonnegative integer, we have for every $u\in
    H_p^\gamma$,
    useenv align* {
        ||\xi_R u||_{H_p^\gamma} = ||\xi_R u||_{W_p^\gamma}
        &= \sum_{|\alpha| <= \gamma} ||D^\alpha (\xi_R u)||_{L_p} \\
        &<= \sum_{|\alpha| <= \gamma} \sum_{\beta <= \alpha}
        \binom{\alpha}{\beta} R^{-|\alpha - \beta|}
        ||(D^{\alpha-\beta}\xi)(\cdot/R)||_{L_oo} ||D^{\beta} u||_{L_p} \\
        &<= N(d,\gamma,\xi) ||u||_{W_p^\gamma}
        = N(d,\gamma,\xi) ||u||_{H_p^\gamma};
    }
    useenv align* {
        ||\xi_R u - u||_{H_p^\gamma} 
        &= ||\xi_R u - u||_{W_p^\gamma} \\
        &= \sum_{|\alpha| <= \gamma} ||D^\alpha (\xi_R u) - D^\alpha u||_{L_p} \\
        &<= \sum_{|\alpha| <= \gamma} \sum_{\beta < \alpha}
        \binom{\alpha}{\beta} R^{-|\alpha - \beta|}
        ||(D^{\alpha-\beta}\xi)(\cdot/R)||_{L_oo} ||D^{\beta} u||_{L_p} \\
        &<= N(d,\xi,\gamma)\sum_{|\alpha| <= \gamma} \sum_{\beta < \alpha}
        R^{-|\alpha - \beta|} ||D^{\beta} u||_{L_p} \\
        &<= N(d,\xi,\gamma) R^{-1} ||u||_{H_p^\gamma}.
    }
    Let us define a sequence of operator
    $$
        T_n : \bigcup_{\gamma\in\Z_+,p} H_p^\gamma -> \bigcup_{\gamma\in\Z_+,p}
        H_p^\gamma
    $$
    by $T_n u(x) = \xi_n(x) u(x) = \xi(x/n)u(x)$. What we shown in above is that
    #eq (eq:bdd-T) {
        ||T_n||_{H_p^\gamma->H_p^\gamma} <= N(d,\gamma,\xi),\quad
        ||T_n - I||_{H_p^\gamma->H_p^\gamma} <= N(d,\gamma,\xi) n^{-1}.
    }
    Using the complex interpolation theorem (see \cite{Tri1} for instance),
    \cref{eq:bdd-T} also holds for every $\gamma>=0$ (need not to be an
    integer).
    Finally, if $\gamma<0$, we use the duality.
    Since $T_n$ is just an operator by multiplying smooth functions,
    ${<T_nu,\phi>} = {<u,T_n\phi>}$ holds for every $u\in H_p^\gamma$ and
    $\phi\in C_0^oo(\R^d)$. Hence, we find
    useenv align* {
        ||T_n u||_{H_p^\gamma}
        = \sup_{\phi\in C_0^oo,\phi!=0} {{<T_n u, \phi>} //
        ||\phi||_{H_q^{-\gamma}}}
        &= \sup_{\phi\in C_0^oo,\phi!=0} {{<u, T_n\phi>} //
        ||\phi||_{H_q^{-\gamma}}} \\
        &<= \sup_{\phi\in C_0^oo,\phi!=0} {||u||_{H_p^\gamma}
        ||T_n\phi||_{H_q^{-\gamma}} // ||\phi||_{H_q^{-\gamma}}}
        <= N(d,\gamma,\xi) ||u||_{H_p^\gamma},
    }
    and similarly, $||T_n u - u||_{H_p^\gamma} <=
    N(d,\gamma,\xi)n^{-1}||u||_{H_p^\gamma}$, where $q = p/(p-1)$.

    Take a sequence $\zeta_k$ from \Cref{coro:1.20}, and $\phi\in C_0^oo(\R^d)$
    such that $0<=\phi<=1$ and $\int \phi = 1$.
    Now we define
    $$
        \Lambda_n u \defeq \zeta_n u,\quad
        \Lambda_{m,n} u \defeq T_m(\zeta_n u),\quad
        \Lambda_{l,m,n} u(x) = \phi_{1/l} * T_m(\zeta_n u).
    $$
    where $\phi_\epsilon(x) = \epsilon^{-d}\phi(x/\epsilon)$.
    Observe that we have the following inequality:
    $$
        ||\Lambda_{l,m,n} u||_{H_p^\gamma} <= ||T_m(\zeta_n
        u)||_{H_p^\gamma}\int \phi dx = ||T_m(\zeta_n u)||_{H_p^\gamma}.
    $$
    Because of \Cref{coro:1.20}, \cref{eq:bdd-T}, and theories about
    mollification, (i), (ii), and (iii) is now proved.

    For (iv), since our construction of $\Lambda_n$, $\Lambda_{m,n}$, and
    $\Lambda_{l,m,n}$ are just a multiplication and mollification of smooth
    functions, one can easily check that (iv) holds. This proves the lemma.
}

useenv remark {
    Upper proof works similarly for $W_{p,\theta}^\gamma$.
}

To show that $C_0^oo(\R_+\times\R_+^d)$ is dense in $\Hb_{p,\theta}^\gamma(T)$,
fix $u\in\Hb_{p,\theta}^\gamma(T)$ first. Notice that $u(t,\cdot)\in
H_{p,\theta}^\gamma$ for almost every $t\in[0,T]$, thus there exists a
modification $\bar u$ of $u$ such that $\bar u(t,\cdot)\in H_{p,\theta}^\gamma$
for every $t\in[0,T]$. We will approximate $\bar u$ by smooth functions. After
this, we write $u$ instead of $\bar u$.

By \Cref{lemma:approx-operators}, we have
$$
    ||\Lambda_{l,m,n} u(t,\cdot)||_{\gamma,p,\theta} <=
    N||u(t,\cdot)||_{\gamma,p,\theta},
$$
and $\Lambda_{l,m,n} u(t,\cdot) -> u(t,\cdot)$ on $H_{p,\theta}^\gamma$ as
$l,m,n->oo$ for every $t\in(0,T)$. Thus by the dominated convergence theorem,
$||\Lambda_{l,m,n} u - u||_{\Hb_{p,\theta}^\gamma(T)}->0$ as $n->oo$.
Furthermore, notice that $\Lambda_{l,m,n} u(t,\cdot)$ is $C_0^oo(\R_+^d)$ for every
$n$ and for every $t\in(0,T)$.
By taking subsequence, one can take a sequence $u_n$ such that $u_n(t,\cdot)$ is
$C_0^oo(\R_+^d)$ for every $t\in(0,T)$, and $u_n -> u$ in
$\Hb_{p,\theta}^\gamma(T)$ as $n->oo$.

Now consider $\eta_m\in C_0^oo(\R_+)$ such that $0<=\eta_m <= 1$, $\supp\eta_m
\in (1/m,T-1/m)$, and $\eta_m = 1$ on $[2/m,T-2/m]$.
Clearly
$$
    ||\eta_m u_n||_{\Hb_{p,\theta}^\gamma(T)}^p
    = \int_0^T \eta_m(t)||u_n(t,\cdot)||_{\gamma,p,\theta}^p dt
    <= ||u_n||_{\Hb_{p,\theta}^\gamma(T)}^p
$$
holds for every $m$, and $|1-\eta_m(t)| ||u_n(t,\cdot)||_{\gamma,p,\theta} -> 0$
as $m->oo$ for every $t\in[0,T]$. The dominated convergence theorem gives
$\eta_m u_n -> u_n$ in $\Hb_{p,\theta}^\gamma(T)$ as $m->oo$.

Finally consider $\phi\in C_0^oo(\R)$ such that $\supp\phi\in (0,1)$,
$0<=\phi<=1$, and $\int\phi dt = 1$, and $\phi_\epsilon(t) =
\epsilon^{-1}\phi(t/\epsilon)$.
Then by the standard mollification argument gives that if we define
$$
    v_{\epsilon,m,n}(t,x) \defeq \int_\R \phi_\epsilon(s) (\eta_m u_n)(t-s,x)ds,
$$
then $v_{\epsilon,m,n} -> \eta_m u_n$ in $\Hb_{p,\theta}^\gamma(T)$ as
$\epsilon\downarrow 0$. Finally observe that $v_{\epsilon,m,n}\in
C_0^oo(\R_+\times\R_+^d)$.

Next, we will prove that $C_0^oo([0,T]\times\R_+^d)$ is dense in
$\Hf_{p,\theta}^\gamma(T)$. Fix $u\in \Hf_{p,\theta}^\gamma(T)$.
Take a subsequence $u_n$ of $\Lambda_{l,m,n}u$.
Then \Cref{lemma:approx-operators} implies $u_{nt} = \Lambda_n u_t$, and thus
useenv align* {
    ||u_n - u||_{\Hf_{p,\theta}^\gamma(T)}
    &= ||M^{-1}(u_n - u)||_{\Hb_{p,\theta}^\gamma(T)}
    + ||M(u_{nt} - u_t)||_{\Hb_{p,\theta}^{\gamma-2}(T)}
    + ||M^{2/p-1}(u_n(0,\cdot) - u(0,\cdot))||_{\gamma-2/p,p,\theta}
    \\
    &= ||u_n - u||_{\Hb_{p,\theta-p}^\gamma(T)}
    + ||\Lambda_n u_{t} - u_t||_{\Hb_{p,\theta+p}^{\gamma-2}(T)}
    + ||u_n(0,\cdot) - u(0,\cdot)||_{\gamma-2/p,p,\theta+2-p}
    \\
    &->0
}
as $n->oo$.

To approximate $u_n$ with smooth functions, together preserving value at $t=0$,
extend $u_n(t,\cdot) = u_n(0,\cdot)$ when $t<=0$ and $u_n(t,\cdot)=0$ for $t>T$.
After that, define
$$
    v_{\epsilon,n}(t,x) \defeq (\phi_\epsilon *_t u_n)(t,x)
    \defeq \int_\R\phi_\epsilon(s) u_n(t-s,x)ds.
$$
Since the support of $\phi$ lie in $(0,1)$ and our way to extend values of
$u_n(t,\cdot)$ for negative $t$, we have
$$
    v_{\epsilon,n}(0,x) = \int_0^1 \phi_\epsilon(s) u_n(-s,x)ds
    = \int_0^1 \phi_\epsilon(s) u_n(0,x)ds = u_n(0,x).
$$
In addition, for every $\psi\in C_0^oo(\R_+^d)$ and $t\in[0,T]$, as $u_{nt} =
\Lambda_n u_t \in M^{-1}\Hb_{p,\theta}^\gamma(T)$,
useenv align* {
    \int_\R\int_0^T \phi_\epsilon(s) |(u_{nt}(\sigma,\cdot),\psi)| d\sigma ds
    &<= \int_\R\int_0^T \phi_\epsilon(s)
    ||u_{nt}(\sigma,\cdot)||_{\gamma,p,\theta+p}||\psi||_{-\gamma,p',\theta'}
    d\sigma ds \\
    &<= ||\psi||_{-\gamma,p',\theta'}\int_0^T
    ||u_{nt}(\sigma,\cdot)||_{\gamma,p,\theta+p} d\sigma \\
    &<= ||\psi||_{-\gamma,p',\theta'} T^{1/p'}
    ||u_{nt}||_{\Hb_{p,\theta+p}^\gamma(T)} < oo.
}
Thus we can apply the Fubini's theorem to obtain
useenv align* {
    (v_{\epsilon,n}(t,\cdot),\psi)
    &= \int_\R \phi_\epsilon(s)(u_n(t-s,\cdot),\psi) ds \\
    &= \int_\R \phi_\epsilon(s) ?[ (u_n(0,\cdot),\psi) + \int_{0}^{t-s}
    (u_{nt}(\sigma,\cdot),\psi) d\sigma ]? ds \\
    &= \int_\R \phi_\epsilon(s) ?[ (u_n(-s,\cdot),\psi) + \int_{-s}^{t-s}
    (u_{nt}(\sigma,\cdot),\psi) d\sigma ]? ds \\
    &= \int_\R \phi_\epsilon(s)(u_n(-s,\cdot),\psi) ds
    + \int_{-s}^{t-s}\int_\R \phi_\epsilon(s) (u_{nt}(\sigma,\cdot),\psi) dsd\sigma\\
    &= \int_\R \phi_\epsilon(s)(u_n(-s,\cdot),\psi) ds
    + \int_{0}^{t}\int_\R \phi_\epsilon(s) (u_{nt}(\sigma-s,\cdot),\psi) dsd\sigma\\
    &= (v_{\epsilon,n}(0,\cdot),\psi) + \int_0^t ((\phi_\epsilon *_t
    u_{nt})(s,\cdot),\psi)ds.
}
This, therefore, implies
$$
    ||M(\diff_t v_{\epsilon,n} - u_{nt})||_{\Hb_{p,\theta}^{\gamma-2}(T)}
    = ||\phi_\epsilon *_t u_{nt} - u_{nt}||_{\Hb_{p,\theta+p}^{\gamma-2}(T)}
    -> 0
$$
as $\epsilon\downarrow 0$, and thus
$||v_{\epsilon,n}-u_n||_{\Hf_{p,\theta}^\gamma(T)} -> 0$ as $\epsilon\downarrow
0$.
Finally, observe that $v_{\epsilon,n} \in C_0^oo([0,T]\times\R_+^d)$.
