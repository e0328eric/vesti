#def #lemma {useenv lemma}

#label(lemma:appx:1)
#lemma {
    Let $A$ be a $d\times d$ nonzero real matrix and $\gamma\in\R$.
    Consider
    $$
        f_A(x) = ?({(Ax,x) // |x|^2})?^\gamma, \quad x\in\R^d
    $$
    Then for every multiindex $\alpha$, we have
    $$
        \sup_x|D^\alpha f_A(x)| <= ||A_"sym"||^\gamma |x|^{-|\alpha|}
        \max_{||B||=1}\max_{|x|=1}|D^\alpha f_B(x)| \eqcolon
        N(d,\alpha)||A_"sym"||^\gamma|x|^{-|\alpha|},
    $$
    where $A_"sym" = (A+A^*)/2$.
    \proof
    As we are dealing with real values, $(Ax,x) = (A_"sym"x,x)$ holds for every
    $x\in\R^d$. Thus it suffices to consider only for symmetric $A$.

    Since $f$ is homogeneous, we have
    $$
        \sup_x|D^\alpha f_A(x)| = |x|^{-|\alpha|}\sup_{|x|=1}|D^\alpha f_A(x)|.
    $$
    Here, observe that $D^\alpha f_A(x) = ||A||^\gamma D^\alpha f_{A/||A||}(x)$,
    thus below inequality is obtained.
    $$
        \sup_x|D^\alpha f_A(x)| <= ||A_"sym"||^\gamma |x|^{-|\alpha|}
        \sup_{||B||=1}\sup_{|x|=1}|D^\alpha f_B(x)| \eqcolon I ||A||^\gamma
        |x|^{-|\alpha|}.
    $$

    In order to show that $I$ is finite, notice that $(x,B) |-> D^\alpha f_B(x)$
    is a rational function on $\R^{d+d^2}$ if we identify a $d\times d$ matrix
    with an element of $\R^{d^2}$.
    Thus it is continuous on $\R^{d+d^2}-!\{0\}$. Since the set
    $$
        \{(x,B) : |x| = 1,\ ||B|| = 1\}
    $$
    is compact, finiteness of $I$ is proved, and the lemma is also proved.
}

#label(lemma:appx:2)
#lemma {
    Let $\sigma$ be an invertible $d\times d$ matrix and $\gamma\in\R$. Consider
    $$
        f(x) = ?({1 + |\sigma^* x|^2 // 1 + |x|^2})?^{\gamma}.
    $$
    Then there exists $\kappa>0$ such that for every multiindex $\alpha$,
    $$
    \sup_x|D^\alpha f(x)| <= N (\lambda^{-\kappa}(\sigma) +
    \Lambda^\kappa(\sigma)) |x|^{-|\alpha|}
    $$
    where $N$ depends only on $d$ and $\alpha$.
    \proof
    Consider
    $$
        A = \Matrix{ 1,0;0,\sigma\sigma^* }.
    $$
    Since $|\sigma^*x|^2 = (\sigma^*x,\sigma^*x) = (\sigma\sigma^*x,x)$,
    we have $f(x) = g(1,x)$, where
    $$
        g(x) = ?({(Ax,x) // |x|^2})?^\gamma,\quad x\in\R^{d+1}.
    $$
    By \Cref{lemma:appx:1}, we find
    $$
        \sup_{x\in\R^d}|D^\alpha f(x)|
        <= \sup_{x\in\R^{d+1}}|D^\alpha g(x)|
        <= N(d,\alpha) ||A||^\gamma |x|^{-|\alpha|}.
    $$
    One can easily check that $||A|| = 1 \vee |\lambda(\sigma)| \vee
    |\Lambda(\sigma)|$.
}

useenv pf [Proof of \cref{eq:1.5}] {
    By the change of variables in spaces $H_p^\gamma$, if $u_n$ converges to $u$
    in $H_p^\gamma$, then $u_n(\sigma\cdot)$ converges to $u(\sigma\cdot)$ in
    $H_p^\gamma$. Thus it suffices to show \cref{eq:1.5} for every $u\in\Sc$.

    Let $\Fs$, $\Fs^{-1}$ denote the Fourier transform and Fourier inverse
    transform, respectively.
    Let $v=u(\sigma\cdot)$. Notice that
    $$
        \Fc(v)(\xi) = |\det\sigma|^{-1}\Fc(u)(\sigma^{-*}\xi),
    $$
    where $\sigma^{-*}=(\sigma^*)^{-1}$.
    From this, we have, by the definition of $H_p^\gamma$-norm and the changing
    of variables in spaces $L_p$ and in Fourier transform,
    useenv align* {
        ||u(\sigma\cdot)||_{\gamma,p}
        &=||v||_{\gamma,p} \\
        &=||(1-\Delta)^{\gamma/2}v||_{p} \\
        &= ?|| \Fc^{-1}?[(1+|\xi|^2)^{\gamma/2}\Fc(v)(\xi)]? ||?_p \\
        &= ?|| \Fc^{-1}?[(1+|\xi|^2)^{\gamma/2}|\det\sigma|^{-1}
        \Fc(u)(\sigma^{-*}\xi)]? ||?_p \\
        &= ?|||\det\sigma^*|
        \Fc^{-1}?[(1+|\sigma^*\xi|^2)^{\gamma/2}|\det\sigma|^{-1}
        \Fc(u)(\xi)]?(\sigma\cdot) ||?_p \\
        &= ?||\Fc^{-1}?[(1+|\sigma^*\xi|^2)^{\gamma/2}
        \Fc(u)(\xi)]?(\sigma\cdot) ||?_p \\
        &= |\det\sigma|^{-p}?||\Fc^{-1}?[(1+|\sigma^*\xi|^2)^{\gamma/2}
        \Fc(u)(\xi)]?||?_p \\
        &= |\det\sigma|^{-p}?||\Fc^{-1}?[
        {(1+|\sigma^*\xi|^2)^{\gamma/2}//(1+|\xi|^2)^{\gamma/2}}
        (1+|\xi|^2)^{\gamma/2} \Fc(u)(\xi)]?||?_p \\
        &=: |\det\sigma|^{-p}?||\Fc^{-1}?[
        M(\xi)(1+|\xi|^2)^{\gamma/2} \Fc(u)(\xi)]?||?_p \\
        &= |\det\sigma|^{-p}?||\Fc^{-1}?[
        M(\xi) \Fc((1-\Delta)^{\gamma/2}u)(\xi)]?||?_p.
    }

    First of all, we have
    $$
        |\det\sigma| = |\det\sigma\sigma^*|^{1/2} >= \lambda^{d/2}(\sigma).
    $$
    In addition, by Theorem 2 in Appendix of \cite{Mikhlin},
    if $M$ is the constant as in the theorem in \cite{Mikhlin},
    then we have
    $$
        ?||\Fc^{-1}?[M(\xi) \Fc((1-\Delta)^{\gamma/2}u)(\xi)]?||?_p
        <= N(p,d) M ?||(1-\Delta)^{\gamma/2}u||?_p
        = N(p,d) M ?||u||?_{\gamma,p}.
    $$
    By \Cref{lemma:appx:2}, the inequality is now proved.
}

