The following is the main result of this section.

#label(thm:5.6) useenv thm {
    For any $\gamma\in\R$, $u_0\in U_{p,\theta}^\gamma$, and
    $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$ in the space $\Hf_{p,\theta}^\gamma(T)$
    there exists a unique solution of \cref{eq:5.1} with initial value
    $u(0,\cdot)=u_0$. For this solution we have
    #eq (eq:5.4) {
        ||u||_{\Hf_{p,\theta}^\gamma(T)}
        <= N(d,\gamma,p,\theta,\delta_0)
        ?(\sum_i||f^i||_{\Hb_{p,\theta}^{\gamma-1}(T)} +
        ||u_0||_{U_{p,\theta}^\gamma})?.
    }
}

To prove this theorem we need two lemmas, the first of which is proved in
next section.

#label(lemma:5.7) useenv lemma { \Cref{thm:5.6} holds for $\gamma=2$. }

#label(lemma:5.8) useenv lemma {
    Let $\mu<=\gamma$, $\theta_1\in\R$, and $u\in\Hf_{p,\theta_1}^\mu(T)$ be a
    solution of \cref{eq:5.1} with initial value $u(0,\cdot)=u_0$.
    Assume that $M^{-1}u\in\Hb_{p,\theta}^\mu(T)$. Then
    $u\in\Hf_{p,\theta}^\gamma(T)$ and
    $$
        ||u||_{\Hf_{p,\theta}^\gamma(T)}
        <= N(d,\gamma,\mu,\theta,p,\delta_0)
        ?(\sum_i||f^i||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        + ||M^{-1}u||_{\Hb_{p,\theta}^\mu(T)}
        + ||u_0||_{U_{p,\theta}^\gamma})? .
    $$
    \proof
    As in the proof of \Cref{lemma:4.7} it suffices to show the case when
    $\mu=\gamma-1$. By virtue of \Cref{remark:5.2} and \Cref{remark:5.4}, in
    order to prove the lemma, it suffices to show that
    #eq (eq:5.8.1) {
        ||u_x||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        <= N(d,\gamma,\mu,\theta,p,\delta_0)
        ?(\sum_i||f^i||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        + ||M^{-1}u||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        + ||u_0||_{U_{p,\theta}^\gamma})? .
    }
    Indeed, if $u_x\in\Hb_{p,\theta}^{\gamma-1}(T)$, then from \cref{eq:5.1},
    $$
        Mu_t = a^{ij}MD_iD_ju + MD_if^i \in \Hb_{p,\theta}^{\gamma-2}(T),
    $$
    and \cref{eq:5.8.1} is easily obtained from the definition of
    $\Hf_{p,\theta}^\gamma(T)$-norm.

    Take a function $\zeta\in C_0^oo(\R_+)$ satisfying condition \cref{eq:1.1}.
    Obviously the function $u_n(t,x)\defeq u(e^{2n}t,e^{n}x)$ satisfy the
    equation
    #eq (eq:5.8.2) {
        u_{nt} = L_nu_n + D_if^i_n,
    }
    where
    $$
        L_nv = a^{ij}_n(t)v_{x^ix^j} \defeq
        a^{ij}(e^{2n}t)v_{x^ix^j},\quad f_n^i(t,x) = e^nf^i(e^{2n}t,e^nx).
    $$
    Hence by remembering that $a$ is symmetric,
    $$
        (\zeta u_n)_t = L_n(\zeta u_n) + \tilde f_n,
    $$
    where $\tilde f_n = \zeta D_if_n^i - 2a_n^{i1}\zeta'u_{nx^i} - a_n^{11}\zeta''u_n$.
    Since $M^{-1}u\in\Hb_{p,\theta}^{\gamma-1}(T)$, for every $\eta\in
    C_0^oo(\R_+)$ we have $\eta u_n\in\Hb_p^{\gamma-1}(e^{-2n}T)$ and $\eta u_{nx} \in
    \Hb_p^{\gamma-2}(e^{-2n}T)$. Indeed, $u_x\in\Hb_{p,\theta}^{\gamma-2}(T)$,
    $$
        \eta(x)u_n(t,x) = e^n (M\eta)(x) (M^{-1}u)(e^{2n}t,e^nx),\quad
        \eta(x)u_{nx}(t,x) = e^n \eta(x) u_x(e^{2n}t,e^n x),
    $$
#def #n {||#1||_{\gamma-1,p,\theta}^p}
    useenv align* {
        ||(M^{-1}u)(e^{2n}\cdot,e^n\cdot)||_{\Hb_{p,\theta}^{\gamma-1}(e^{-2n}T)}^p
        &= \int_0^{e^{-2n}T}#n((M^{-1}u)(e^{2n}t,e^n\cdot))dt \\
        &= e^{-n\theta p}\int_0^{e^{-2n}T}#n((M^{-1}u)(e^{2n}t,\cdot))dt \\
        &= e^{-n\theta p-2n}\int_0^{T}#n((M^{-1}u)(t,\cdot))dt \\
        &= e^{-n\theta p-2n} ||M^{-1}u||_{\Hb_{p,\theta}^{\gamma-1}(T)}^p.
    }
#undef #n
    Similarly, as $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$, we
    have $\tilde f_n\in\Hb_p^{\gamma-2}(e^{-2n}T)$.
    Now following the proof of Lemma 3.6 of \cite{half-line} almost gives the
    proof.\footnote{
        However, for $1<p<2$, we cannot apply all theorems introduced in
        \cite{half-line} because the initial value space is not correct. For
        correct one, we should introduce Besov spaces.
    }
    Notice that we need a following inequality instead of the one in
    \cite{half-line}.
    useenv align* {
        \sum_{n=-oo}^oo
        e^{(2-p+\theta)n}||\zeta D_if_n^i||_{\Hb_p^{\gamma-2}(e^{-2n}T)}^p
        &= \sum_{n=-oo}^oo
        e^{(2-p+\theta)n}||e^{2n}\zeta
        (D_if^i)(e^{2n}\cdot,e^n\cdot)||_{\Hb_p^{\gamma-2}(e^{-2n}T)}^p \\
        &= \sum_{n=-oo}^oo
        e^{(2+\theta)n}||e^{n}\zeta
        (D_if^i)(e^{2n}\cdot,e^n\cdot)||_{\Hb_p^{\gamma-2}(e^{-2n}T)}^p \\
        &= \sum_{n=-oo}^oo
        e^{n\theta}||e^{n}\zeta
        (D_if^i)(\cdot,e^n\cdot)||_{\Hb_p^{\gamma-2}(T)}^p \\
        &= \sum_{n=-oo}^oo
        e^{n\theta}||(MD_if^i)(\cdot,e^n\cdot)M^{-1}\zeta||_{\Hb_p^{\gamma-2}(T)}^p \\
        &= ||MD_if^i||_{\Hb_{p,\theta}^{\gamma-2}(T)}^p \\
        &<= N||f^i||_{\Hb_{p,\theta}^{\gamma-1}(T)}^p,
    }
    and similar for other terms. The lemma is proved.
}
\goodbreak
useenv pf (\Cref{thm:5.6}) {
    Similar with the proof of \Cref{thm:4.1}, we split two cases to consider.

    \it{Case $\gamma>=2$}. The uniqueness follows from \Cref{lemma:5.7} and the
    fact that $\Hf_{p,\theta}^\gamma\subset\Hf_{p,\theta}^2$, any two solutions
    coinside in $\Hf_{p,\theta}^2$, and thus they are indistinguishable.
    For the existence of the solution, we use \Cref{lemma:5.7}, \Cref{lemma:5.8}
    with $\mu=2$, and $||M^{-1}u||_{\Hb_{p,\theta}^2(T)}<=
    N||u||_{\Hf_{p,\theta}^2(T)}$ by \Cref{remark:5.2}.

    \it{Case $\gamma<2$}. As same as in the proof of \Cref{thm:4.1}, the case
    $1<=\gamma<2$ is enough to consider.

    Define an operator $\Rc$ maps $(u_0,f^1,...f^d)\in
    U_{p,\theta}^\gamma\times (\Hb_{p,\theta}^{\gamma-1}(T))^d$ into the solution
    $u\in\Hf_{p,\theta}^\gamma(T)$ of \cref{eq:5.1} with initial value
    $u(0,\cdot)=u_0$. We already proved that such operator $\Rc$ is well-defined
    when $\gamma>=2$.
#def #L {\Lc_{2,0}}
    Consider
    $$
        v =
        \Rc(M^{1-2/p}#L^{-1}M^{2/p-1}u_0,#L^{-1}f^1,...,#L^{-1}f^d).
    $$
    Notice that by \Cref{thm:2.16}, $#L$ has a bounded inverse, so $v$ is
    well-defined and belongs to $\Hf_{p,\theta}^{\gamma+2}(T)$.
    Define $\tilde u = #L v$. It is not hard to show that $\tilde
    u\in\Hf_{p,\theta}^\gamma(T)$. By definition $v$ satisfies
    $$
        v_t = a^{ij}v_{x^ix^j} + D^i#L^{-1}f^i
    $$
    with initial value $v(0,\cdot) = M^{1-2/p}#L^{-1}M^{2/p-1}u_0$.
    Apply $#L$ at the both side we have\footnote{
        Notice that we understand $v_t = h$ by the distributions sense, which is
        $$(v(t,\cdot),\phi) = (v(0,\cdot),\phi) + \int_0^t (h(s,\cdot),\phi)ds$$
        for every $\phi\in C_0^oo(\R^d_+)$.
        By applying $#L$ we mean that substitute $#L^*\phi$ in the above
        formula, where $#L^*$ is the formal adjoint of $#L$.
    }
    $$
        \tilde u_t = a^{ij}\tilde u_{x^ix^j} + D^i f^i + \tilde f,
        \quad \tilde u(0,\cdot) = u_0 + \tilde u_0,
    $$
    where
    $$
        \tilde f = a^{ij}#L v_{x^ix^j} - a^{ij}(#L v)_{x^ix^j} + #L D^i
        #L^{-1}f^i - D^if^i,\quad \tilde u_0 = #L M^{1-2/p}#L^{-1}M^{2/p-1}u_0 -
        u_0.
    $$
    Formulas as in the proof of \Cref{thm:4.1}, and the formula
    $$
        #L M^\alpha \phi = M^{\alpha}#L\phi +
        2\alpha M^{\alpha+1}D^1\phi + \alpha^2 M^\alpha\phi,\quad
        \forall\alpha\in\R,
    $$
    gives
    $$
        \tilde f
        = -2a^{i1}D^iM^{-1}\Lc_{1,0}v -2a^{1j}
        M^{-1}\Lc_{1,0}D^jv - 2M^{-1}\Lc_{1,0}#L^{-1}f^1,
    $$
    $$
        M^{2/p-1}\tilde u_0 = (2-4/p)MD^1#L^{-1}M^{2/p-1}u_0 +
        (1-2/p)^2#L^{-1}M^{2/p-1}u_0.
    $$
    By \Cref{remark:2.2}, \Cref{coro:2.5}, and \Cref{coro:2.12}, we find $\tilde u_0\in
    U_{p,\theta}^{\gamma+1}$.
    In addition, as $v_x\in\Hb_{p,\theta}^{\gamma+1}(T)$ since
    $v\in\Hf_{p,\theta}^{\gamma+2}(T)$, we have
    $$
        MD^iM^{-1}\Lc_{1,0}v = MD^i\sum_j MD^j(D^jv) + MD^iD^1v \in
        \Hb_{p,\theta}^{\gamma-1}(T).
    $$
    Hence, $M\tilde f\in\Hb_{p,\theta}^{\gamma-1}(T)$. By \Cref{remark:2.15},
    one can take $\tilde f^i\in\Hb_{p,\theta}^\gamma(T)$ such that $\tilde f =
    M^{-1}(M\tilde f) = D^i\tilde f^i$.
    Since $\gamma>=1$, $\bar u = \Rc(\tilde u_0,\tilde f^1,...,\tilde f^d)$ is
    well-defined and $\bar u\in\Hf_{p,\theta}^{\gamma+1}(T)$.
    Now $u = \tilde u - \bar u$ belongs to $\Hf_{p,\theta}^\gamma(T)$ and solves
    \cref{eq:5.1}. Estimate \cref{eq:5.4} follows easily from the above
    construction and known estimates for $\Rc$, $#L$, $MD$.

    For the uniqueness, it suffices to consider $f=0$, $u_0=0$ (and $\gamma<2$).
    In this case, any solutions $u\in\Hf_{p,\theta}^\gamma(T)$ belongs to
    $\Hf_{p,\theta}^2(T)$ by \Cref{lemma:5.8}. Thus the uniqueness follows from
    \Cref{lemma:5.7}. The theorem is now proved.
}
