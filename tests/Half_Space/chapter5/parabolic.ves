As in \Cref{sec:4} we assume that condition \cref{eq:4.1} is satisfied.
In this section we are dealing with the equation
#eq (eq:5.1) {
    u_t = Lu + D_if^i\quad t\in[0,T],\ x^1>0,
}
where $T\in[0,oo)$ is given,
$$
    Lu = a^{ij}(t)u{x^ix^j},
$$
and $a(t)=(a^{ij}(t))$ is a given symmetric $d\times d$ matrix valued function
depending only on $t$. We assume that it is a Borel function satisfying, for
each $t>0$, condition \cref{eq:4.6} with a fixed constant $\delta_0>0$.

We need some spaces of functions depending on $t$.
Before introducing the space, we need another type of weighted Sobolev space.
useenv defin {
    Let $\zeta\in C_0^oo(\R_+)$ be from \Cref{defin:1.1}.
    For $\gamma,\theta\in\R$ and $p\in(1,oo)$ we define a space
    $W_{p,\theta}^\gamma$ by all distributions $u$ such that
    $$
        ||u||_{W_{p,\theta}^\gamma}^p
        \defeq \sum_{n=-oo}^oo
        e^{n\theta}||u(e^n\cdot)\zeta||_{B_{p,p}^\gamma}^p < oo,
    $$
    where $B_{p,p}^\gamma$ denotes the Besov space.
}
In the main paper, one uses $M^{1-2/p}H_{p,\theta}^{\gamma-2/p}$ for the
initial function space. However, this works only if $p >= 2$, and in addition,
this is not optimal.

#label (defin:5.1)
useenv defin {
    Let
    $$
        \Hb_{p,\theta}^\gamma(T) =
        L_p((0,T),\Bf(\R_+),H_{p,\theta}^\gamma),\quad
        \Lb_{p,\theta}(T) = \Hb_{p,\theta}^0(T).
    $$
    For a function $u : [0,T] -> \Dc'(\R_+^d)$,\footnote{
        Recall that $\Dc'(\R_+^d)$ is the set of all distributions on $\R_+^d$.
    } we write
    $u\in\Hf_{p,\theta}^\gamma(T)$ if
    #enum ((\roman*)) {
        \item we have #eq (eq:5.2) {
            M^{-1}u\in\bigcup_\mu\Hb_{p,\theta}^\mu(T),\quad
            u_x\in\Hb_{p,\theta}^{\gamma-1}(T),\quad
            u(0,\cdot)\in M^{1-2/p}W_{p,\theta}^{\gamma-2/p}\eqcolon
            U_{p,\theta}^\gamma;
        }
        \item there is a function $u_t=u_t(t)$ defined for $t\in(0,T)$ with
        values in the set of distributions of $\R_+^d$ such that
        $$
            Mu_t \in \Hb_{p,\theta}^{\gamma-2}(T),\quad
            (u(t,\cdot),\phi) = (u(0,\cdot),\phi) + \int_0^t
            (u_t(s,\cdot),\phi)ds
        $$
        for any $\phi\in C_0^oo(\R_+^d)$ and $t\in[0,T]$.
    }
    Let
    #eq (eq:5.3) {
        ||h||_{U_{p,\theta}^\gamma} = ||M^{2/p-1}h||_{\gamma-2/p,p,\theta},\quad
        ||u||_{\Hf_{p,\theta}^\gamma(T)}
        = ||u_x||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        + ||Mu_t||_{\Hb_{p,\theta}^{\gamma-2}(T)}
        + ||u(0,\cdot)||_{U_{p,\theta}^\gamma}.
    }
}

useenv remark {
    Notice that such $u_t$ is unique ($t$-a.e.).
    Indeed, if there exists $f$ and $g$ satisfies
    $$
        (u(t,\cdot),\phi) = (u(0,\cdot),\phi) + \int_0^t
        (f(s,\cdot),\phi)ds
        = (u(0,\cdot),\phi) + \int_0^t (g(s,\cdot),\phi)ds
    $$
    for every $\phi\in C_0^oo(\R_+^d)$ and $t\in [0,T]$, where equations is
    meaningful, then for fixed $\phi\in C_0^oo(\R_+^d)$,
    $$
        \int_0^t (f(s,\cdot),\phi)ds = \int_0^t (g(s,\cdot),\phi)ds
    $$
    holds for every $t\in [0,T]$, hence $(f(t,\cdot),\phi) = (g(t,\cdot),\phi)$
    for almost every $t\in[0,T]$.\footnote{
        We then have $\int_a^b (f(s,\cdot),\phi)ds = \int_a^n
        (g(s,\cdot),\phi)ds$ holds for every $0<=a<=b<=T$.
        This shows that $\int_0^T (f(t,\cdot),\phi)s(t)dt = \int_0^T
        (g(t,\cdot),\phi)s(t)dt$ for every simple Borel function $s$.
        Now take a sequence of simple functions $(s_n)_n$ such that $s_n(t) ->
        (f(t,\cdot)-g(t,\cdot),\phi)$ pointwise and $|s_n(t)|<=
        |(f(t,\cdot)-g(t,\cdot),\phi)|$ for every $t$.
        Then apply the dominated convergence theorem.
    }
    Since $C_0^oo(\R_+^d)$ is a separable topological vector space,
    we obtain that $(f(t,\cdot),\phi) = (g(t,\cdot),\phi)$ for every $\phi\in
    C_0^oo(\R_+^d)$ for almost every $t\in[0,T]$.
    This proves $f(t) = g(t)$ for almost every $t\in [0,T]$.
}

We will always understand \cref{eq:5.1} in the sense of \Cref{defin:5.1}
assuming that $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$.

#label(remark:5.2) useenv remark {
    By \Cref{thm:2.6} and \Cref{coro:2.12} the first two conditions in
    \cref{eq:5.2} can be replaced with $M^{-1}u\in\Hb_{p,\theta}^\gamma(T)$. In
    addition,
    $$
        ||M^{-1}u||_{\Hb_{p,\theta}^\gamma(T)}
        <= N||u_x||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        <= N||M^{-1}u||_{\Hb_{p,\theta}^\gamma(T)}.
    $$
}

#label(remark:5.3) useenv remark {
    By \Cref{remark:2.2} it follows that $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$
    only if $D_if^i\eqcolon M^{-1}f$ with $f\in\Hb_{p,\theta}^{\gamma-2}(T)$.
    Therefore, $D_if^i$ in \cref{eq:5.1} may be replaced with $M^{-1}f$, where
    $f\in\Hb_{p,\theta}^{\gamma-2}(T)$.

    On the other hand, by \Cref{remark:2.15} any $M^{-1}f$ with
    $f\in\Hb_{p,\theta}^{\gamma-2}(T)$ can be represented in a canonical way as
    $D_if^i$ with $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$ and
    $$
        ||f||_{\Hb_{p,\theta}^{\gamma-2}(T)}
        <= N\sum_i||f^i||_{\Hb_{p,\theta}^{\gamma-1}(T)}
        <= N||f||_{\Hb_{p,\theta}^{\gamma-2}(T)}.
    $$
}

#label(remark:5.4) useenv remark {
    Observe that for any $u\in\Hb_{p,\theta}^\gamma(T)$ and
    $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$ the right-hand side of \cref{eq:5.1}
    belongs to $M^{-1}\Hb_{p,\theta}^{\gamma-2}(T)$, so that \cref{eq:5.1} makes
    sense in $\Hf_{p,\theta}^\gamma(T)$.\footnote{
        See \cref{eq:5.2} that the space where $u_t$ is located.
    }
    Indeed, the right-hand side of \cref{eq:5.1} equals
    $(a^{ij}u_{x^j}+f^i)_{x^i}$ where
    $a^{ij}u_{x^j}+f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$ by definitions and
    assumptions. It only remains to remember \Cref{remark:2.2}.

    This argument also shows that any $u\in\Hf_{p,\theta}^\gamma(T)$ satisfies
    \cref{eq:5.1} with $f^i\defeq Q_iM(u_t-Lu)$,\footnote{
        Recall that $u = MD_iQ_iu$.
    }where
    $M(u_t-Lu)\in\Hb_{p,\theta}^{\gamma-2}(T)$,\footnote{
        Since $u_x\in\Hb_{p,\theta}^{\gamma-1}(T)$, $MLu =
        a^{ij}M(u_{x^i})_{x^j}\in\Hb_{p,\theta}^{\gamma-2}(T)$.
    } $f^i\in\Hb_{p,\theta}^{\gamma-2}(T)$.

    Furthermore, notice for the future that the operator $u |-> M(u_t-Lu)$ is a
    bounded operator from $\Hf_{p,\theta}^\gamma(T)$ into
    $\Hb_{p,\theta}^{\gamma-2}(T)$. It follows from \Cref{remark:5.3} that to
    prove the unique solvability of \cref{eq:5.1} for any
    $f^i\in\Hb_{p,\theta}^{\gamma-1}(T)$ it is necessary and sufficient to prove
    that the mapping $u |-> M(u_t-Lu)$ from $\Hf_{p,\theta}^\gamma(T)$ to
    $\Hb_{p,\theta}^{\gamma-2}(T)$ is bijective.
}

#label(remark:5.5) useenv remark {
    It is known that $C_0^oo(\R_+\times\R_+^d)$ is dense in
    $\Hb_{p,\theta}^\gamma(T)$, and $C_0^oo([0,T]\times\R_+^d)$ is dense in
    $\Hf_{p,\theta}^\gamma(T)$. See \Cref{sec:pf-remark:5.5} for the proof.

    Here, notice that $\R_+ = (0,oo)$. Thus support of functions in time is the
    type $[\epsilon,N]$ where $0 < \epsilon < N < oo$.
    However, if $f\in C_0^oo([0,T]\times\R_+^d)$, then the support of $f$ may
    touch $0$ or $T$.
    This means that we cannot use cutoff function to approximate
    $\Hf_{p,\theta}^\gamma(T)$.

    The actual reason why $C_0^oo(\R_+\times\R_+^d)$ is not dense in
    $\Hf_{p,\theta}^\gamma(T)$ is that in the definition of the
    $\Hf_{p,\theta}^\gamma(T)$-norm, the initial value $u(0,\cdot)$ is
    introduced.
    Notice that for any $f\in C_0^oo(\R_+\times\R_+^d)$, $f(0,\cdot) = 0$, hence
    we cannot approximate with such functions.
}

--[=[
#label(remark:5.5) useenv remark {
    It follows from \Cref{coro:1.20} that, for any
    $u\in\Hb_{p,\theta}^\gamma(T)$, we have $\zeta_k(x^1)u(t,x)->u(t,x)$ in
    $\Hb_{p,\theta}^\gamma(T)$ by the dominated convergence theorem. This
    implies that the space $C_0^oo(\R_+\times\R_+^d)$ is everywhere dense in
    $\Hb_{p,\theta}^\gamma(T)$.\footnote{
