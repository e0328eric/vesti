#def #thm {useenv thm}
#def #lemma {useenv lemma}
#def #coro {useenv coro}
#def #remark {useenv remark}
#def #defin {useenv defin}
#def #TODO {
    useenv center {
        \bf{\color{red}[Fill Here!!]}
    }
}
#def #L {\Lc_{#1}}
#def #n {||#1||_{#2,p,\theta}}

The above results admit stronger forms needed in the future in the particular
case $\theta!=d-1$ and $\theta!=p+d-1$.

#label(thm:2.11) #thm {
    #enum ((\roman*)) {
        \item Let $\theta!=d-1$ and $b$ be such that
        #eq (eq:2.13) {
            (\theta-d+1)^2 < (\theta-d+1)(b-1).
        }
        Then for any $\gamma$ and $p$ the operator $\Lc_{b,0}$ is a bounded 1-1
        operator from the space $H_{p,\theta}^\gamma$ onto
        $H_{p,\theta}^{\gamma-2}$ and its inverse is also bounded.
        \item Let $\theta!=p+d-1$ and $b$ such that
        $$
            (\theta-p-d+1)^2 < (\theta-p-d+1)(b-1).
        $$
        Then for any $\gamma$ and $p$ the operator
        $M^{-1}\Lc_{b,0}M=MD_iD_iM+bD_1M$ is a bounded 1-1 operator from the
        space $H_{p,\theta}^\gamma$ onto $H_{p,\theta}^{\gamma-2}$ and its
        inverse is also bounded.
    }
    \proof
    #enum ((\roman*)) {
        \item Owing to \Cref{thm:2.8} and the method of continuity, we only
        need to show that for all $c>=0$ and $u\in H_{p,\theta}^\gamma$ we
        have
        #eq (eq:2.14) {
            #n(u)(\gamma) <= N#n(\Lc_{b,c}u)(\gamma-2),
        }
        where $N$ is independent of $u$ and $c$.
        Indeed, for fixed $f\in H_{p,\theta}^{\gamma-2}$, consider a collection
        $C\subset [0,oo)$ of $c$ such that $\Lc_{b,c}$ is bijective and
        satisfies \cref{eq:2.14}. Fix $c^*\in C$, $c\in[0,oo)$ and define an
        operator $Q_c:H_{p,\theta}^\gamma->H_{p,\theta}^\gamma$ such that for
        any $u\in H_{p,\theta}^\gamma$,
        $$
            \Lc_{b,c^*}Q_cu + (c^*-c)u = f.
        $$
        Notice that for any $u_1,u_2\in H_{p,\theta}^\gamma$,
        $$
            ||Q_c u_1 - Q_c u_2||_{\gamma,p,\theta}
            <= N ||\Lc_{b,c^*}Q_c u_1 - \Lc_{b,c^*}Q_c u_2||_{\gamma-2,p,\theta}
            = N |c-c^*| ||u_1 - u_2||_{\gamma,p,\theta},
        $$
        where $N$ is independent of $c$ and $c^*$. Thus one can make $Q_c$ a
        contraction if $c$ is close enough to $c^*$ and the distance of which
        does not depends on $c$ and $c^*$, say $\delta>0$.

        What we proved is that there exists $\delta>0$ such that for any $c^*\in
        C$ and $|c-c^*|<\delta$, then $c\in C$. Since $C$ is not empty because
        of \Cref{thm:2.8}, we therefore obtain $C=[0,oo)$, which proves (i) of
        this theorem.

        We know from \Cref{thm:2.7} that this estimate holds for large $c$, say
        $c>=c^*=c^*(\gamma)=c^*(b,\gamma)$. For $c\in[0,c^*(\gamma)]$ we have
        useenv align* {
            #n(u)(\gamma)
            &<= N#n(\Lc_{b,c^*(\gamma)}u)(\gamma-2) \\
            &<= N#n(\Lc_{b,c}u)(\gamma-2) +
            |c^*(\gamma)-c|N#n(u)(\gamma-2)\\
            &<= N#n(\Lc_{b,c}u)(\gamma-2) +
            |c^*(\gamma)-c|N#n(\Lc_{b,c^*(\gamma-2)}u)(\gamma-4)\\
            &<= N#n(\Lc_{b,c}u)(\gamma-2) +
            |c^*(\gamma)-c|N#n(\Lc_{b,c}u)(\gamma-4)
            + |c^*(\gamma)-c| |c^*(\gamma-2)-c|N#n(u)(\gamma-4) \\
            &<= (N+N|c^*(\gamma)-c|)#n(\Lc_{b,c}u)(\gamma-2) +
            + (N|c^*(\gamma)-c|^2 + N|c^*(\gamma)-c|)#n(u)(\gamma-4)
        }
        because
        $$
            |c^*(\gamma-2)-c| <= |c^*(\gamma-2)-c^*(\gamma)| +
            |c^*(\gamma)-c|.
        $$
        Continuing this process and since $c^*(\gamma)-c <= c^*(\gamma)$,
        we have $<= N#n(\Lc_{b,c}u)(\gamma-2) + N#n(u)(\gamma-2n)$.
        Here $n$ is any nonnegative integer and $N$ are independent of $u$ and
        $c\in[0,c^*(\gamma)]$. It follows that it suffices to prove that for any
        $\gamma$ there exists $n>=1$ and $N\in(0,oo)$ such that, for any $u\in
        H_{p,\theta}^\gamma$ and $c>=0$,
        #eq (eq:2.15) {
            #n(u)(\gamma-2n) <= N#n(\Lc_{b,c}u)(\gamma-2).
        }
        Of course, we may confine ourselves to the case $u\in C_0^oo(\R_+^d)$.

        First, let $\gamma>=2$. Then take $n$ such that $\gamma-2n<=0$ and
        notice that, for $f\defeq -\Lc_{b,c}u$ by formula \cref{eq:2.10} and
        \Cref{remark:1.3}, we have\footnote{
            In the third equality, we used the following fact.
            $$
                \Eb\exp?(w_t^1 - {t//2})?
                = {1//\sqrt{2\pi t}}\int_\R e^{x-t/2}e^{-x^2/(2t)}dx
                = {1//\sqrt{2\pi t}}\int_\R e^{-(x-t)^2/(2t)}dx = 1.
            $$
            Similar method also proves that $\Eb\exp(\alpha w_t^1+\beta t) =
            \exp(\alpha^2t/2+\beta t)$.
            Now remember that $\xi_t=w_t^1\sqrt{2}+(b-1)t$.
        }
        useenv align* {
            #n(u)(\gamma-2n)
            &<= N#n(u)(0) \\
            &<= N\Eb\int_0^oo e^{-ct}#n(f(\sigma_t\cdot))(0)dt \\
            &= N\Eb\int_0^oo e^{-ct}e^{-\xi_t(\theta-d+1)/p}
            #n(f(\sigma_t\cdot))(0)dt \\
            &= N#n(\Lc_{b,c}u)(0)
            \int_0^oo e^{-ct-(\theta-d+1)(b-1)t/p+(\theta-d+1)^2t/p^2}dt \\
            &<= N#n(\Lc_{b,c}u)(0)
            \int_0^oo e^{{-(\theta-d+1)(b-1)t+(\theta-d+1)^2t//p}}dt \\
            &= N#n(\Lc_{b,c}u)(0) \\
            &<= N#n(\Lc_{b,c}u)(\gamma-2),
        }
        where $N$ is independent of $u$ and $c$. In this way, we have also
        proved \cref{eq:2.14} for $\gamma>=2$.

        If $\gamma<2$, take $n=1$ and an integer $m>=2$ such that
        $\gamma+2(m-1)<4$ and $\gamma+2m>=4$ and define
        $$
            \bar c = c^*(\gamma-2)\vee c^*(\gamma)\vee...\vee c^*(\gamma+2m-2).
        $$
        Then
        $$
            #n(u)(\gamma-2n) = N#n(u)(\gamma-2)
            <= N#n(\Lc_{b,\bar c}^{-1}u)(\gamma)
            <= ...
            <= N#n(\Lc_{b,\bar c}^{-m}u)(\gamma+2m-2).
        $$
        In addition, by the above result $(\gamma+2m-2>=2)$ (and \cref{eq:2.14}
        for $\gamma>=2$ since we already proved)
        \goodbreak
        useenv align* {
            #n(\Lc_{b,\bar c}^{-m}u)(\gamma+2m-2)
            <= N#n(\Lc_{b,c}\Lc_{b,\bar c}^{-m}u)(\gamma+2m-4)
            &= N#n(\Lc_{b,\bar c}^{-m}\Lc_{b,c}u)(\gamma+2m-4) \\
            &<= N#n(\Lc_{b,c}u)(\gamma-4)
            <= N#n(\Lc_{b,c}u)(\gamma-2)
        }
        with the constant $N$ independent of $u$ and $c$. This proves the
        assertion (i).
        \item This follows from (i) and \Cref{coro:1.6}. Indeed, the equation
        $M^{-1}\Lc_{b,0}Mu = f$ is equivalent to $\Lc_{b,0}v = g$ with $v = Mu$
        and $g = Mf$. In addition, $u\in H_{p,\theta}^\gamma$ and $f\in
        H_{p,\theta}^{\gamma-2}$ if and only if $v\in H_{p,\theta-p}^\gamma$ and
        $g\in H_{p,\theta-p}^{\gamma-2}$.
    }
    The theorem is proved.
}

#label(coro:2.12) #coro {
    #enum ((\roman*)) {
        \item If $\theta!=d-1$ and $u\in H_{p,\theta}^\gamma$, then
        #eq (eq:2.16) {
            ||u||_{\gamma,p,\theta} <=
            N(d,\gamma,p,\theta)||MDu||_{\gamma-1,p,\theta}.
        }
        In particular, in this case the term $N||u||_{\gamma-1,p,\theta}$ in
        \cref{eq:2.1} can be dropped. Furthermore, in \Cref{coro:2.9} one can
        take $u_0=0$.
        \item If $\theta!=d+p-1$ and $u\in H_{p,\theta}^\gamma$, then
        $$
            ||u||_{\gamma,p,\theta} <=
            N(d,\gamma,p,\theta)||DMu||_{\gamma-1,p,\theta}.
        $$
        In particular, in this case the terms $N||u||_{\gamma-1,p,\theta}$ in
        \cref{eq:2.2} and $||M^{-1}u||_{\mu,p,\theta}$ in \cref{eq:2.5} can be
        dropped.
    }
    \proof
    #enum ((\roman*)) {
        \item Observe that $\Lc_{b,0}u = MD_iMD_iu + (b-1)MD_1u$.\footnote{
            Notice that $M^2\Delta u = \sum_1^d MD_jMD_ju - D_1u$.
        }
        Hence, for an appropriate $b$,
        $$
            #n(u)(\gamma) <= N#n(\Lc_{b,0}u)(\gamma-2)
            <= N#n(MDu)(\gamma-1) + N#n(MD_1u)(\gamma-2),
        $$
        and \cref{eq:2.16} follows.

        The second assertion in (i) follows from the fact that $u = \Lc_{b,0}v =
        MD_iv^i + (b-1)MD_1v$, where $v\defeq\Lc_{b,0}^{-1}u$, $v^i\defeq
        MD_iv$, and
        $$
            #n(v)(\gamma+1) + #n(v^i)(\gamma+1)
            <= #n(v)(\gamma+1) + N#n(v)(\gamma+2)
            <= N#n(v)(\gamma+2) <= N#n(u)(\gamma).
        $$
        
        Indeed, first inequality in \cref{eq:2.1} comes immediately from
        \cref{eq:2.16}. The second part is obvious.
        Now in \Cref{coro:2.9}, we have
        $$
            u = MD_i u^i
        $$
        where $u^1=(b-1)v + v^1$ and $u^i=v^i$ for $i=2,3,...,d$.

        \item Apply \Cref{coro:1.6} and the result in (i) to get
        #undef #n
        #def #n {||#1||_{#2,p,#3}}
        $$
            #n(u)(\gamma)(\theta)
            <= N#n(Mu)(\gamma)(\theta-p)
            <= N#n(MDMu)(\gamma-1)(\theta-p)
            <= N#n(DMu)(\gamma-1)(\theta).
        $$
        The same result can also be obtained from \Cref{thm:2.11} (ii) if one
        notices that $M^{-1}\Lc_{b,0}Mu = MD_iD_iMu+bD_1Mu$.

        Indeed, it suffices to show the second assertion. First of all,
        $$
            ||Du||_{\gamma-1,p,\theta}
            = ||DMM^{-1}u||_{\gamma-1,p,\theta} <=
            N||M^{-1}u||_{\gamma,p,\theta}.
        $$
        On the other hand, assume that $Du\in H_{p,\theta}^{\gamma-1}$, and
        let $v = M^{-1}\Lc_{b,0}u$. Since
        useenv align* {
            ||v||_{\gamma-2,p,\theta}
            &= ||M^{-1}\Lc_{b,0}u||_{\gamma-2,p,\theta} \\
            &<= ||MD_iD_iu||_{\gamma-2,p,\theta} + N||D_1u||_{\gamma-2,p,\theta} \\
            &<= N||Du||_{\gamma-1,p,\theta} + N||Du||_{\gamma-2,p,\theta} \\
            &<= N||Du||_{\gamma-1,p,\theta},
        }
        we have $v\in H_{p,\theta}^{\gamma-2}$. Thus by \Cref{thm:2.11} (ii), there
        exists $w\in H_{p,\theta}^\gamma$ such that $M^{-1}\Lc_{b,0}Mw = v$.
        Since $M^{-1}\Lc_{b,0}M$ is bijective, $w = M^{-1}u$, hence $M^{-1}u\in
        H_{p,\theta}^\gamma$ and
        $$
            ||M^{-1}u||_{\gamma,p,\theta} <= N||v||_{\gamma-2,p,\theta}
            <= N||Du||_{\gamma-1,p,\theta}.
        $$
    }
    The corollary is proved.
}
#undef #n
#def #n {||#1||_{#2,p,\theta}}

#label(remark:2.13) #remark {
    The way we arrived at \Cref{coro:2.12} is much more complicated than in
    one-dimensional case (see \cite{half-line}), where we had similar assertions
    almost for free.
}

#label(defin:2.14) #defin {
    Let $\theta!=d-1$. Fix a $b$ such that \cref{eq:2.13} holds and for any
    $u\in H_{p,\theta}^\gamma$ define $Qu=(Q_1u,...,Q_du)$, where
    $$
        Q_1u = MD_1#L(b,0)^{-1}u + (b-1)#L(b,0)^{-1}u, \quad
        Q_iu = MD_i#L(b,0)^{-1}u,\quad i=2,...,d.
    $$
}

#label(remark:2.15) #remark {
    By what we have seen in the proof of \Cref{coro:2.12}, $Q$ is a bounded
    operator from $H_{p,\theta}^\gamma$ to $H_{p,\theta}^{\gamma+1}$ (or better
    say to $(H_{p,\theta}^{\gamma+1})^d$) and $u = MD_iQ_iu$.
}

If $\theta>d-1$, then condition \cref{eq:2.13} means that $b>1$ and
$\theta<(b-1)+d-1$. It turns out that, for $\theta>d-1$, assertion (i) of
\Cref{thm:2.11} holds under less restrictive conditions.

#label(thm:2.16) #thm {
    Let $b,c\in\R$ and
    $$
        d - 1 < \theta < d - 1 + p(b-1) + p^2c(\theta-d+1)^{-1}.
    $$
    Then for any $\gamma$ the operator $#L(b,c)$ is a bounded 1-1 operator from
    $H_{p,\theta}^\gamma$ onto $H_{p,\theta}^{\gamma-2}$ and its inverse is also
    bounded.
}

To prove this theorem we need the following standard result, which is proved in
Appendix.

#label(lemma:2.17) #lemma {
    Let $(a,b)\subset\R$ and $u\in W_p^2(a,b)$. Then
    #enum ((\roman*)) {
        \item the functions $|u|^{p/2}$ and $|u|^{p-2}uu_x$ are absolutely
        continuous on $(a,b)$,
        \item almost everywhere on $(a,b)$ ($oo\cdot 0 \defeq 0$ if $1<p<2$)
        #eq (eq:2.17) {
            (|u|^{p/2})_{x} = {p//2}|u|^{p/2-2}uu_{x},\quad
            (|u|^{p-2}uu_{x})_{x}
            = |u|^{p-2}uu_{xx} + (p-1)|u|^{p-2}(u_{x})^2.
        }
    }
}

useenv pf [\Cref{thm:2.16}] {
    As in the proof of \Cref{thm:2.11} it suffices to prove estimate
    \cref{eq:2.15} with $\gamma>=2$ for $u\in C_0^oo(\R_+^d)$.\footnote{
        Repeat the proof of \Cref{thm:2.11} for the case $\gamma<2$.
    } This case can be
    further reduced into by proving the following inequality
    $$
        #n(u)(0) <= N#n(#L(b,c)u)(0).
    $$
    Indeed then for sufficiently large $n$,
    $$
        #n(u)(\gamma-2n) <= #n(u)(0) <= N#n(#L(b,c)u)(0) <=
        N#n(#L(b,c)u)(\gamma-2),
    $$
    because $\gamma>=2$.

    Define
    $$
        f = (x^1)^2\Delta u + bx^1u_{x^1} - cu\ \ (=#L(b,c)u),
    $$
    multiply both parts of this equality by $(x^1)^{\theta-d}|u|^{p-2}u$, and
    integration by parts, \Cref{lemma:2.17},\footnote{
        \Cref{lemma:2.17} states for only one dimensional. However, as $u$ has a
        compact support, we can apply \Cref{lemma:2.17} per coordinates.
    } and Fubini's theorem (also remember
    that $u\in C_0^oo(\R_+^d)$).\footnote{
        If $1<p<2$, then $|u|^{p-2}u$ is nonsense because the case $0^{-1}$ can
        happen. However if one adopt $oo\cdot 0 \defeq 0$, on the set
        $\{u=0\}$, every calculation also valid, thus we can just calculate
        integrals like the context.

        In addition, Fubini's theorem is used in order to apply the fundamental
        theorem of calculus.
    }
    useenv align* {
        \int_{\R_+^d}(x^1)^{\theta-d+2}|u|^{p-2}u\Delta u dx
        &= -\int_{\R_+^d}(x^1)^{\theta-d+2}(p-1)|u|^{p-2}|u_x|^2 dx +
        \sum_{i=1}^d\int_{\R_+^d}(x^1)^{\theta-d+2}(|u|^{p-2}uu_{x^i})_{x^i}
        dx \\
        &= -\int_{\R_+^d}(x^1)^{\theta-d+2}(p-1)|u|^{p-2}|u_x|^2 dx \\
        &\kern1cm+ \sum_{i=1}^d
        (x^1)^{\theta-d+2}|u|^{p-2}uu_{x^i}\bigg|_{"if"\ (i==1)\ 0\ "else"\
        -oo}^oo \\
        &\kern2cm-\int_{\R_+^d}
        (\theta-d+2)(x^1)^{\theta-d+1}|u|^{p-2}uu_{x^1} dx \\
        &= -\int_{\R_+^d}(x^1)^{\theta-d+2}(p-1)|u|^{p-2}|u_x|^2 dx
        -\int_{\R_+^d}
        p^{-1}(\theta-d+2)(x^1)^{\theta-d+1}(|u|^{p})_{x^1} dx,
    }
    useenv align* {
        \int_{\R_+^d}(x^1)^{\theta-d+1}|u|^{p-2}uu_{x^1}dx
        &= (x^1)^{\theta-d+1}|u|^p\bigg|_0^oo
        - \int_{\R_+^d}p^{-1}(\theta-d+1)(x^1)^{\theta-d}|u|^{p}dx \\
        &= - \int_{\R_+^d}p^{-1}(\theta-d+1)(x^1)^{\theta-d}|u|^{p}dx.
    }
    Combining these, we have
    useenv align* {
        &-\int_{\R^d_+}(x^1)^{\theta-d}|u|^{p-2}ufdx \\
        &\kern2cm= (p-1)\int_{\R^d_+}(x^1)^{\theta-d+2}|u|^{p-2}|u_x|^2dx
        + \alpha \int_{\R^d_+}(x^1)^{\theta-d+1}(|u|^{p})_{x^1}dx
        + \beta \int_{\R^d_+}(x^1)^{\theta-d}|u|^{p}dx \\
        &\kern2cm= (p-1)\int_{\R^d_+}(x^1)^{\theta-d+2}|u|^{p-2}|u_x|^2dx
        + (\beta - (\theta-d+1)\alpha)\int_{\R^d_+}(x^1)^{\theta-d}|u|^{p}dx
    }
    where $\alpha = p^{-1}(\theta-d+2)$ and $\beta = p^{-1}(\theta-d+1)b+c$,
    and in the middle term we again integrate by parts.
    On the left use H\"older's inequality.\footnote{
        with measure $(x^1)^{\theta-d}dx$.
    } We also define $v = |u|^{p/2}$. This and \Cref{lemma:2.17} yields
    useenv align* {
        #n(f)(0)#n(u)(0)^{p-1}
        &>= \int_{\R_+^d}(x^1)^{\theta-d}|u|^{p-1}|f|dx \\
        &>= ?|\int_{\R_+^d}(x^1)^{\theta-d}|u|^{p-2}ufdx|? \\
        &>= -\int_{\R_+^d}(x^1)^{\theta-d}|u|^{p-2}ufdx \\
        &= (p-1)\int_{\R^d_+}(x^1)^{\theta-d+2}|u|^{p-2}|u_x|^2dx
        + \tau\int_{\R^d_+}(x^1)^{\theta-d}|u|^{p}dx \\
        &>= 4p^{-2}(p-1)\int_{\R^d} (x^1)^{\theta-d+2}|v_x|^2dx
        + \tau#n(u)(0)^p \\
        &>= 4p^{-2}(p-1)\int_{\R^d} (x^1)^{\theta-d+2}|v_{x^1}|^2dx
        + \tau#n(u)(0)^p,
    }
    where $\tau = \beta - (\theta-d+1)\alpha$.
    To transform the remaining integeral we use Minkowski's inequality and
    again \Cref{lemma:2.17} to find\footnote{
        Since $v = |u|^{p/2}$ is absolutely continuous, we can apply the
        fundamental theorem of calculus to write (also $|v(x)| -> 0$ as $|x|
        ->oo$)
        $$
            v(x) = -\int_{x^1}^oo v_{x^1}(t,x')dt
            = -x^1\int_1^oo v_{x^1}(tx^1,x')dt.
        $$
        
    }
    useenv align* {
        #n(u)(0)^p
        &= \int_{\R^d_+}(x^1)^{\theta-d}|v|^2dx \\
        &= \int_{\R^d_+}(x^1)^{\theta-d}
        ?|x^1\int_1^oo v_{x^1}(tx^1,x')dt|?^2dx \\
        &<= ?(\int_1^oo ?(\int_{\R^d_+}(x^1)^{\theta-d+2}
        |v_{x^1}(tx^1,x')|^2dx)?^{1/2}dt)?^2 \\
        &= ?(\int_1^oo ?(\int_{\R^d_+}(x^1/t)^{\theta-d+2}t^{-1}
        |v_{x^1}(x^1,x')|^2dx)?^{1/2}dt)?^2 \\
        &= \int_{\R_+^d}(x^1)^{\theta-d+2}|v_{x^1}|^2dx ?(\int_1^oo
        t^{-(\theta-d+3)/2}dt)?^2,
    }
    where the integral with respect to $t$ converges and equals
    $2(\theta-d+1)^{-1}$ since $\theta>d-1$. Thus
    $$
        {(\theta-d+1)^2//4}#n(u)(0)^p
        <= \int_{\R_+^d}(x^1)^{\theta-d+2}|v_{x^1}|^2dx,\quad
        #n(f)(0)#n(u)(0)^{p-1} >= \kappa^{-1}#n(u)(0)^p,
    $$
    where
    $$
        \kappa \defeq \tau + (\theta-d+1)^2p^{-2}(p-1)
        = p^{-2}(\theta-d+1)(p(b-1)+d-1+p^2c(\theta-d+1)^{-1}-\theta).
    $$
    By assumption $\kappa > 0$, so that $#n(u)(0) <= \kappa^{-1}#n(f)(0)$ and
    the theorem is proved.
}

