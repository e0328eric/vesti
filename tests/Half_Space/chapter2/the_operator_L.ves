#def #sum {\sum_{#1}^{#2}}
#def #L {\Lc_{#1}}
#def #H { H_{#1,#2}^{#3}}
#def #norm { ?||#1||?_{#2}}
#def #canon_norm {#norm(#1)(\gamma,p,\theta)}
#def #TODO {useenv center { \bf{\color{red} [Fill here!!]} }}
#def #thm {useenv thm}
#def #lemma {useenv lemma}
#def #remark {useenv remark}
#def #coro {useenv coro}

The following operators will play an important role in the future.
For $b,c\in\R$ define
$$
    #L(b,c)u = M^2\Delta u + bMD_1u - cu.
$$

By using \Cref{remark:2.2} and the formulas
#eq (eq:2.3) {
    useenv aligned {
        M^2\Delta &= #sum(i=1)(d) (MD_i)^2-MD_1, \\
        M^{-1}#L(b,c)Mu &= MD_iD_iMu + bD_1Mu - cu
    }
}
we get the following.

#label(coro:2.5)
useenv coro {
    The operators $#L(b,c)$ and $M^{-1}#L(b,c)M$ are bounded operators from
    $#H(p)(\theta)(\gamma)$ to $#H(p)(\theta)(\gamma-2)$.
}

#label(thm:2.6) useenv thm {
    We have $M^{-1}u\in#H(p)(\theta)(\gamma)$ if and only if
    #eq (eq:2.4) {
        u_x \in H_{p,\theta}^{\gamma-1},\quad M^{-1}u\in\bigcup_\mu
        H_{p,\theta}^\mu.
    }
    Moreover, there exists constants $N=N(d,\gamma,\mu,\theta,p)$ such that, for
    any $\mu<=\gamma$ and any $\theta,p$, and $M^{-1}u\in H_{p,\theta}^\gamma$,
    #eq (eq:2.5) {
        #canon_norm(M^{-1}u)
        <= N#norm(u_x)(\gamma-1,p,\theta) + N#norm(M^{-1}u)(\mu,p,\theta)
        <= N#canon_norm(M^{-1}u).
    }
#undef #H
    \proof
    Observe that
    #eq (eq:2.6) {
        MD_i(M^{-1}u) = u_{x^i} - \delta^{1i}M^{-1}u.
    }
    By \Cref{thm:2.1} and \cref{eq:2.6}, we can obtain the following inequalites.
    $$
        #norm(M^{-1}u)(\gamma,p,\theta)
        <= N #norm(M^{-1}u)(\gamma-1,p,\theta) + N#norm(M(M^{-1}u)_x)(\gamma-1,p,\theta)
        <= N #norm(M^{-1}u)(\gamma-1,p,\theta) + N#norm(u_x)(\gamma-1,p,\theta),
    $$
    $$
        #norm(M^{-1}u)(\gamma-1,p,\theta) + #norm(u_x)(\gamma-1,p,\theta)
        <= N#norm(M^{-1}u)(\gamma-1,p,\theta) + #norm(M(M^{-1}u)_x)(\gamma-1,p,\theta)
        <= N#norm(M^{-1}u)(\gamma,p,\theta).
    $$
    We can apply the above inequalites with $\gamma-n$ instead of $\gamma$ where
    $n$ is any positive integer. Thus inductively, we obtain
    useenv align* {
        #norm(M^{-1}u)(\gamma,p,\theta)
        &<= N#norm(u_x)(\gamma-1,p,\theta) + N#norm(M^{-1}u)(\gamma-1,p,\theta)
        \\
        &<= N#norm(u_x)(\gamma-1,p,\theta) + N#norm(u_x)(\gamma-2,p,\theta) +
        N#norm(M^{-1}u)(\gamma-2,p,\theta) \\
        &<= ... \\
        &<= N#sum(j=1)(n)#norm(u_x)(\gamma-j,p,\theta) + N#norm(M^{-1}u)(\gamma-n,p,\theta)
        \\
        &<= N#norm(u_x)(\gamma-1,p,\theta) + N#norm(M^{-1}u)(\gamma-n,p,\theta),
    }
    $$
        #norm(M^{-1}u)(\gamma-n,p,\theta) + #norm(u_x)(\gamma-1,p,\theta)
        <= #norm(M^{-1}u)(\gamma-1,p,\theta) + #norm(u_x)(\gamma-1,p,\theta)
        <= N#norm(M^{-1}u)(\gamma,p,\theta).
    $$
    Thus we proved \cref{eq:2.5} when $\mu = \gamma-n$ for every positive
    integer $n$, and thus covers the case of all such $\mu<=\gamma$.
    Obviously, \cref{eq:2.5} implies \cref{eq:2.4}, and thus the theorem is
    proved.
}

#undef #canon_norm
#def #H { H_{p,\theta}^{#1}}
#def #canon_norm {#norm(#1)(#2,p,\theta)}

Next, we need several results allowing us to move along the scale of spaces
$#H(\gamma)$. Also, these results characterize $#H(\gamma)$ as an image of
$#H(\gamma-2)$.

#label(thm:2.7)
useenv thm {
    For any $b,\gamma,p$, and $\theta$ there exists a constant $c_0>0$ such that
    for any $c\geq c_0$ and $u\in H_{p,\theta}^{\gamma}$,
    \begin{equation}\label{eq:2.7}
         \left\|u\right\|_{\gamma,p,\theta} \leq  N
         \left\|\Lc_{b,c}u\right\|_{\gamma-2,p,\theta},\quad
        c \left\|u\right\|_{\gamma-2,p,\theta} \leq  N
        \left\|\Lc_{b,c}u\right\|_{\gamma-2,p,\theta},
    \end{equation}
    where the constant $N$ are independent of $u$ and $c$.
    \proof
    First, notice that, by \Cref{remark:2.2} and \Cref{thm:1.11}
    \begin{equation}\label{eq:2.8}
        \|MD_iu\|_{\gamma-2,p,\theta}
        \leq N\|u\|_{\gamma-1,p,\theta}
        \leq N\|u\|_{\gamma,p,\theta}^{1/2}\|u\|_{\gamma-2,p,\theta}^{1/2}.
    \end{equation}
    Next, we have
    \begin{equation}\label{eq:2.9}
        I \defeq \|u\|_{\gamma,p,\theta}^p
        = \sum_{n=-\infty}^\infty
        e^{n\theta}\|(1-\Delta)(u(e^n\cdot)\zeta)\|_{\gamma-2,p}^p
        \leq N\|u\|_{\gamma-2,p,\theta}^p + \sum_{n=-\infty}^\infty
        e^{n\theta}\|\Delta(u(e^n\cdot)\zeta)\|_{\gamma-2,p}^p.
    \end{equation}

    Here
    \[
        \Delta(u(e^n\cdot)\zeta)
        = u(e^n\cdot)\Delta\zeta + (M^2\Delta u)(e^n\cdot)M^{-2}\zeta
        + 2(MD_iu)(e^n\cdot)M^{-1}D_i\zeta,
    \]
    so that by \Cref{lemma:1.4} the last sum in \cref{eq:2.9} is less than
    \[
        N\|u\|_{\gamma-2,p,\theta}^p + N\|MDu\|_{\gamma-2,p,\theta}^p
        + N\|\Lc_{b,c}u-bMD_1u+cu\|_{\gamma-2,p,\theta}^p.
    \]
    Owing to \cref{eq:2.8} this expression is less than
    \[
        N(1+c)\|u\|_{\gamma-2,p,\theta}^p
        + NI^{1/2}\|u\|_{\gamma-2,p,\theta}^{p/2} +
        N\|\Lc_{b,c}u\|_{\gamma-2,p,\theta}^p.
    \]
    Now we are going to use Young's inequality\footnote{
        If $p,q>0$ and $p^{-1}+q^{-1}=1$, then for every $a,b>0$,
        $ab <= p^{-1}a^p + q^{-1}b^q$.
    } provided that the second
    inequality of \cref{eq:2.7} holds. For every $\epsilon>0$ and $c>=c_0$,
    useenv align* {
        I &<=
        N(1+c)\|u\|_{\gamma-2,p,\theta}^p
        + NI^{1/2}\|u\|_{\gamma-2,p,\theta}^{p/2} +
        N\|\Lc_{b,c}u\|_{\gamma-2,p,\theta}^p \\
        &<= N\|\Lc_{b,c}u\|_{\gamma-2,p,\theta}^p
        + N ?({\epsilon//c} I^{1/2})? ?({c//\epsilon}
        ||u||_{\gamma-2,p,\theta}^{p/2})? \\
        &<= N\|\Lc_{b,c}u\|_{\gamma-2,p,\theta}^p
        + N {\epsilon^2//c^2} I +  N {c^2//\epsilon^2}
        ||u||_{\gamma-2,p,\theta}^{p}.
    }
    This, therefore, gives that
    $$
        ?(1 - N{\epsilon^2//c^2})?I <= ?(N + N{c^{2-p}//\epsilon^2})?
        ||\Lc_{b,c}||_{\gamma-2,p,\theta}^p.
    $$
    By letting $\epsilon>0$ small enough, one can make the coefficient of the
    left side be positive, thus to prove the first one of \cref{eq:2.7} it now
    suffices to prove the second one.

    To prove the second inequality of \cref{eq:2.7}, first of all, assume that
    $u\in C_0^\infty (\R_+^d)$ because of \Cref{thm:1.19}, put $f =
    -\Lc_{b,c}u$, and for any $x\in\R_+^d$ denote by $x_t(x)$ a unique solution
    of the stochastic equation
    \[
        dx_t = bx_t^1e_1dt + \sqrt{2}x_t^1dw_t
    \]
    with the initial data $x_0=x$ where $w_t=(w_t^1,w_t')$ is a $d$-dimensional
    Wiener process and  $e_1 = (1,0,\cdots ,0)$. Notice that the above stochastic
    equation corresponds to the Kolmogorov equation
    \[
        \Lc_{b,c}u = -f.
    \]
    Observe that $x_t(x) = \sigma_tx$, where
    \[
        \sigma_t = \Matrix{
            e^{\xi_t},0,\cdots ,0;
            |,,,;
            \eta_t, , I_{d-1}, ;
            |,,,;
        },\quad \xi_t = w_t^1\sqrt{2} + (b-1)t,\quad \eta_t = \sqrt{2}\int_0^t
        e^{\xi_s}dw_s'.
    \]
    Indeed, we can split the stochastic equation by two parts:
    \[
        dx_t^1 = bx_t^1dt + \sqrt{2}x_t^1dw_t^1,\quad
        dx_t' = \sqrt{2}x_t^1dw_t'.
    \]
    By Lemma IV.3.1 on \cite{Kry-diffusion}, we have $x_t^1(x) = (\sigma_tx)^1 =
    \exp(\xi_t)x^1$. Then $x_t' = x' + \sqrt{2}\int_0^tx_t^1dw_t'$, thus we
    obtain the above result.

    By It\^o's formula applied to $u(x_t(x))\exp(-ct)$ we get
    \[
        du(x_t)
        = u_{x^i}(x_t)dx_t^i + \frac12 u_{x^ix^j}(x_t)(dx_t^i)(dx_t^j)
        = (M^2\Delta u + bMD_1u)(x_t)dt + \sqrt{2}(MDu)(x_t)dw_t,
    \]
    \[
        d[u(x_t)\exp(-ct)] = -e^{-ct}f(x_t)dt + \sqrt{2}e^{-ct}(MDu)(x_t)dw_t.
    \]
    By taking the expectation, we have
    \[
        \Eb u(x_t)e^{-ct} = u(x) - \Eb\int_0^t e^{-cs}f(x_s)ds
        + \sqrt{2}\Eb\int_0^t e^{-cs}(MDu)(x_s)dw_s.
    \]
    Since $u\in C_0^\infty(\R_+^d)$, the integrand of the stochastic integral
    lies in $L_2(\llo0,\infty\rro,\Pc)$, expectation of the stochastic integral
    vanishes. In addition, letting $t\to\infty$, $\Eb u(x_t)e^{-ct}\to 0$
    because $u\in C_0^oo(\R_+^d)$. Hence, we get
    \begin{equation}\label{eq:2.10}
        u(x) = \Eb\int_0^\infty e^{-ct}f(x_t(x))dt
        = \Eb\int_0^\infty e^{-ct}f(\sigma_tx)dt,
    \end{equation}
    and\footnote{
        Consider $\Phi:\Omega\times(0,oo)->H_{p,\theta}^{\gamma-2}$ by
        $\Phi(t)=e^{-ct}f(\sigma_t\cdot)$.
        Since $H_{p,\theta}^{\gamma-2}$ is separable, by the Pettis theorem,
        $\Phi$ is strongly measurable.
        If $\mu=\Pb\times\ell$, then $u = \int_X\Phi d\mu$ where
        $X=\Omega\times(0,oo)$ and the integration is understood by Bochner
        integral sense. Hence, by the Bochner integral theory,
        $$
            ||u||_{\gamma-2,p,\theta}
            <= \int_X ||\Phi||_{\gamma-2,p,\theta}d\mu
            = \Eb\int_0^oo e^{-ct} ||f(\sigma_t\cdot)||_{\gamma-2,p,\theta}dt.
        $$
    }
    \[
        \|u\|_{\gamma-2,p,\theta}
        \leq \Eb\int_0^\infty e^{-ct}\|f(\sigma_t\cdot)\|_{\gamma-2,p,\theta}dt.
    \]
    Next, we want to apply \Cref{lemma:1.9}. It follows that by definition that
    \[
        |\sigma_t^*x|^2 = |e^{\xi_t}x^1 + \eta_t\cdot x'|^2 + |x'|^2,\quad
        \det\sigma_t\sigma_t^* = (\det\sigma_t)^2 = e^{2\xi_t}.
    \]
    Using this, we find
    \[
        \Lambda(\sigma_t) = \sup_{|x|=1|}|\sigma_t^*x|^2
        \leq N(e^{\xi_t}+|\eta_t|)^2
        \leq N(e^{2\xi_t}+|\eta_t|^2),
    \]
    \[
        \lambda(\sigma_t) \geq (\Lambda(\sigma_t))^{-d+1}\det\sigma_t\sigma_t^*
        \geq N^{-1}e^{2\xi_t}(e^{2\xi_t}+|\eta_t|^2)^{-d+1},
    \]
    \[
        \lambda^{-\kappa}(\sigma_t) + \Lambda^\kappa(\sigma_t)
        \leq Ne^{N|\xi_t|} + N|\eta_t|^N + N.
    \]
    Now we are going to estimate the expectation of the last expression.
    It is easy to check that $e^{|x|} \leq e^x + e^{-x}$,
    and simple calculation about $\Eb e^{aw_t}$,\footnote{
        $\Eb e^{aw_t} = e^{a^2t/2}$
    }
    \[
        \Eb e^{N|\xi_t|}
        \leq \Eb e^{N\xi_t} + \Eb e^{-N\xi_t}
        \leq e^{N(b-1)t+Nt} + e^{-N(b-1)t+Nt},
    \]
    where $N$ are constants independent of $t$.

    To estimate $\Eb|\eta_t|^N$, we use Burkholder-Davis-Gundy inequality.
    We find $\langle\eta\rangle_t = \int_0^t 2e^{2\xi_t}dt$, and
    \[
        \Eb|\eta_t|^N \leq N \Eb \langle\eta\rangle_t^{N/2}
        = \Eb \left(\int_0^t 2e^{2\xi_s}ds\right)^{N/2}
        \eqcolon I.
    \]
    One can take $N$ large enough so we assume that $N>=2$. In this case,
    the Minkowski's inequality gives
    \[
        I \leq \left(\int_0^t \Eb(2e^{2\xi_s})^{N/2}ds\right)^{N/2}
        = N \left(\int_0^t \Eb e^{N\xi_s}ds\right)^{N/2}
        = Ne^{N(b-1)t+Nt}.
    \]
    Notice that $N$ are constants independent of $t$.

    Hence, they are less than $Ne^{c_0t/2}$ for an appropriate $c_0>0$.
    This proves the second inequality in \cref{eq:2.7} and the theorem.
}

#label(thm:2.8)
useenv thm {
    Take $b,\gamma,p,\theta$, and $c_0$ from \Cref{thm:2.7}.
    Then there exists a constant $c_1$ depending only on $d$ and $b$ such that
    for any $c\geq c_0\vee c_1$ the operator $\Lc_{b,c}$ is a bounded 1-1
    operator from the space $H_{p,\theta}^\gamma$ onto $H_{p,\theta}^{\gamma-2}$
    and its inverse is also bounded.
    \proof
    Owing to \Cref{thm:2.7} it suffices to prove that, for large $c$, the range
    of $\Lc_{b,c}$ is dense in $H_{p,\theta}^{\gamma-2}$.
    By virtue of \Cref{thm:1.19} we have only to prove that given $f\in
    C_0^oo(\R_+^d)$, there exists a function $u\in H_{p,\theta}^\gamma$ such
    that $\Lc_{b,c}u = -f$.

    Define $u$ by \cref{eq:2.10}. Then by well-known results about Kolmogorov's
    equations (see, for instance, Theorem V.8.5 of \cite{Kry-diffusion}) there
    exists a constant $c_1$ depending only on $d$ and $b$ such that if $c\geq
    c_1$, then $u$ is twice continuously differentiable and $\Lc_{b,c}u = -f$
    (even in $\R^d$). In the proof of \Cref{thm:2.7} we have seen that if in
    addition $c\geq c_0$, then
    $$
        ||u||_{\gamma,p,\theta} <=
        \Eb\int_0^oo e^{-ct}||f(\sigma_t\cdot)||_{\gamma,p,\theta}dt
        <= N\int_0^oo e^{(c_0-c)t}dt < oo,
    $$
    hence, $u\in H_{p,\theta}^{\gamma}$.
}

useenv remark {
    In \cref{eq:2.7}, the first inequality is proved provided that $u\in
    H_{p,\theta}^\gamma$. Hence, one cannot use the first one directly in the
    proof of \Cref{thm:2.8}. However, the second inequality is proved without
    the condition $u\in H_{p,\theta}^\gamma$.
}


#def #n {||#1||_{#2,p,\theta}}
#label(coro:2.9) #coro {
    For every $u\in H_{p,\theta}^\gamma$ and $\mu>=1$ there exists functions
    $u^i\in H_{p,\theta}^{\gamma+1}$, $i=1,...,d$, and $u^0\in
    H_{p,\theta}^{\gamma+\mu}$ such that
    #eq (eq:2.11) {
        u = u^0 + MD_iu^i
    }
    and
    #eq (eq:2.12) {
        #n(u^0)(\gamma+\mu) + \sum_{i=1}^d#n(u^i)(\gamma+1)
        <= N#n(u)(\gamma)
        <= N?( #n(u^0)(\gamma+\mu) + \sum_{i=1}^d#n(u^i)(\gamma+1))?
    }
    with constants $N$ independent of $u$.
    \proof
    Notice that given \cref{eq:2.11}, the estimate on the right in
    \cref{eq:2.12} follows from \Cref{remark:2.2}. Our assertion become stronger
    if $\mu$ becomes larger. Therefore, we may concentrate on integral $\mu$.
    In this case one can use the induction on $\mu$. Indeed, if we have our
    assertions for $\mu=1$, then representing $u^0$ as another sum like
    \cref{eq:2.11} with a new first term from $H_{p,\theta}^{\gamma+2}$, we will
    have our assertion for $\mu=2$, and so on.\footnote{
        Also remember that, obviously, $H_{p,\theta}^{\gamma+1}\subset
        H_{p,\theta}^\gamma$.
    }This shows that it only remains
    to consider $\mu=1$.

    By \Cref{thm:2.7} and \ref{thm:2.8} we have $u = M^2\Delta v - cv$ and
    $#n(v)(\gamma+2)<=N#n(u)(\gamma)$. This, formulas \cref{eq:2.3}, and
    \Cref{remark:2.2} finish the proof.
}

#label(remark:2.10) useenv remark {
    Generally the term $u^0$ in \cref{eq:2.12} cannot be dropped. Indeed, for
    $d=1$, $u(x)\defeq I_{x>=2}(\ln x)^{-1}$, and $\theta=\gamma=0$, we have
    $u\in H_{p,\theta}^\gamma = L_p(\R,x^{-1}dx)$. However, there is no solution
    $v\in L_p(\R,x^{-1}dx)$ of the equation $xv'(x) = u(x)$.
}
