set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)

set(VCPKG_OSX_ARCHITECTURES arm64)
set(VCPKG_OSX_DEPLOYMENT_TARGET 11.0)
set(VCPKG_FIXUP_MACHO_RPATH OFF)
set(ZIG_TARGET aarch64-macos)

if(PORT STREQUAL "harfbuzz")
  set(VCPKG_MESON_CONFIGURE_OPTIONS "-Dgpu=disabled")
endif()

if(PORT STREQUAL "icu")
  set(VCPKG_MAKE_CONFIGURE_OPTIONS "--disable-extras")
endif()

if(DEFINED ENV{SDKROOT})
  set(VCPKG_OSX_SYSROOT "$ENV{SDKROOT}")
endif()

set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/zig-macos-toolchain.cmake")
set(VCPKG_HASH_ADDITIONAL_FILES "${CMAKE_CURRENT_LIST_DIR}/zig-macos-toolchain.cmake")
set(VCPKG_ENV_PASSTHROUGH SDKROOT MACOSX_SDK ZIG ZIG_GLOBAL_CACHE_DIR)
